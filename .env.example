# Database
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=insurance_db

# LINE Bot (จาก developers.line.biz)
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
# LINE User ID ของเจ้าหน้าที่ที่รับแจ้งเตือน lead ใหม่ (ดูจาก Webhook event → source.userId)
LINE_ADMIN_USER_ID=

# Claude AI (จาก console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key

# App URL (ใช้สำหรับ link ใน LINE messages)
APP_URL=https://yourdomain.com

# Gemini (optional)
GEMINI=your_gemini_api_key

# Email / SMTP (nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=ระบบประกันรถยนต์ <noreply@yourdomain.com>
ADMIN_EMAIL=admin@yourdomain.com
SITE_PHONE=02-xxx-xxxx

# Session secret (เปลี่ยนให้ยาว 32+ ตัวอักษร)
SESSION_SECRET=your-random-secret-key-at-least-32-characters

# Sentry Error Tracking (optional)
# สร้าง project ที่ sentry.io แล้วใส่ DSN ที่นี่
SENTRY_DSN=

# Node environment
NODE_ENV=production

# Scraper (จำนวน model ที่รัน parallel พร้อมกัน, default=5, เพิ่มได้ถ้า server ปลายทางรับได้)
SCRAPER_CONCURRENCY=5