<% if (msg) { %><div class="adm-alert adm-alert-success"><%= msg %></div><% } %>

<div class="adm-cars-grid">

  <!-- BRANDS -->
  <div class="adm-card">
    <div class="adm-card-title">🏷️ ยี่ห้อรถยนต์ (<%= brands.length %>)</div>

    <form action="/admin/cars/brand/add" method="POST" class="adm-inline-form">
      <input type="text" name="name" placeholder="ชื่อยี่ห้อใหม่" required>
      <button type="submit" class="adm-btn adm-btn-primary">+ เพิ่ม</button>
    </form>

    <div class="adm-list">
      <% brands.forEach(b=>{ %>
        <div class="adm-list-item">
          <span><%= b.name %></span>
          <form action="/admin/cars/brand/<%= b.id %>/delete" method="POST"
                onsubmit="return confirm('ลบ <%= b.name %>?')">
            <button type="submit" class="adm-btn-del">ลบ</button>
          </form>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- MODELS -->
  <div class="adm-card adm-card-wide">
    <div class="adm-card-title">🚗 รุ่นรถยนต์ (<%= models.length %>)</div>

    <form action="/admin/cars/model/add" method="POST" class="adm-inline-form adm-model-form">
      <select name="brand_id" required>
        <option value="">เลือกยี่ห้อ</option>
        <% brands.forEach(b=>{ %><option value="<%= b.id %>"><%= b.name %></option><% }) %>
      </select>
      <input type="text" name="name" placeholder="ชื่อรุ่น" required>
      <input type="number" name="base_value" placeholder="ราคา (บาท)" min="0" step="1000" required>
      <button type="submit" class="adm-btn adm-btn-primary">+ เพิ่ม</button>
    </form>

    <div class="adm-table-wrap">
      <table class="adm-table">
        <thead><tr><th>ยี่ห้อ</th><th>รุ่น</th><th>ราคาฐาน</th><th>แก้ไข</th><th>ลบ</th></tr></thead>
        <tbody>
          <% models.forEach(m=>{ %>
            <tr>
              <td><%= m.brand_name %></td>
              <td id="model-name-<%= m.id %>"><%= m.name %></td>
              <td id="model-val-<%= m.id %>">฿<%= formatNumber(m.base_value) %></td>
              <td>
                <button class="adm-link-sm" onclick="openEditModel(<%= m.id %>,'<%= m.brand_id %>','<%= m.name.replace(/'/g,`\\'`) %>',<%= m.base_value %>)">แก้ไข</button>
              </td>
              <td>
                <form action="/admin/cars/model/<%= m.id %>/delete" method="POST"
                      onsubmit="return confirm('ลบ <%= m.name %>?')" style="display:inline">
                  <button type="submit" class="adm-btn-del">ลบ</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Edit Model Modal -->
<div id="editModelModal" class="adm-modal" style="display:none">
  <div class="adm-modal-box">
    <div class="adm-modal-title">✏️ แก้ไขรุ่นรถ</div>
    <form id="editModelForm" method="POST">
      <div class="adm-modal-field">
        <label>ยี่ห้อ</label>
        <select name="brand_id" id="em_brand" required>
          <% brands.forEach(b=>{ %><option value="<%= b.id %>"><%= b.name %></option><% }) %>
        </select>
      </div>
      <div class="adm-modal-field">
        <label>ชื่อรุ่น</label>
        <input type="text" name="name" id="em_name" required>
      </div>
      <div class="adm-modal-field">
        <label>ราคาฐาน (บาท)</label>
        <input type="number" name="base_value" id="em_val" min="0" step="1000" required>
      </div>
      <div class="adm-modal-actions">
        <button type="button" onclick="closeEditModal()" class="adm-btn adm-btn-ghost">ยกเลิก</button>
        <button type="submit" class="adm-btn adm-btn-primary">บันทึก</button>
      </div>
    </form>
  </div>
</div>
