<% if (admin.role === 'affiliate') { %>
<div class="adm-card adm-card-full" style="margin-bottom:16px;background:linear-gradient(135deg,#7c3aed,#5b21b6);color:#fff">
  <div style="display:flex;gap:32px;flex-wrap:wrap;padding:4px 0">
    <div>
      <div style="font-size:24px;font-weight:700">฿<%= formatNumber(totals.pending_commission||0) %></div>
      <div style="opacity:.8;font-size:13px">Commission ค้างจ่าย</div>
    </div>
    <div>
      <div style="font-size:24px;font-weight:700">฿<%= formatNumber(totals.paid_commission||0) %></div>
      <div style="opacity:.8;font-size:13px">จ่ายแล้วทั้งหมด</div>
    </div>
    <div>
      <div style="font-size:24px;font-weight:700"><%= totals.converted_count||0 %></div>
      <div style="opacity:.8;font-size:13px">Leads ปิดงานสำเร็จ</div>
    </div>
  </div>
</div>
<% } %>

<!-- FUNNEL STATS -->
<div class="adm-stats">
  <div class="adm-stat adm-stat-blue">
    <div class="adm-stat-icon"><i data-lucide="clipboard-list"></i></div>
    <div>
      <div class="adm-stat-val"><%= totals.today_leads || 0 %></div>
      <div class="adm-stat-lbl">Leads วันนี้</div>
      <div class="adm-stat-sub">เดือนนี้ <%= totals.month_leads || 0 %> leads</div>
    </div>
  </div>
  <div class="adm-stat adm-stat-green">
    <div class="adm-stat-icon"><i data-lucide="mouse-pointer-click"></i></div>
    <div>
      <div class="adm-stat-val"><%= totals.total_clicked || 0 %></div>
      <div class="adm-stat-lbl">คลิก LINE / FB</div>
      <div class="adm-stat-sub">LINE <%= totals.total_line_clicks||0 %> · FB <%= totals.total_fb_clicks||0 %></div>
    </div>
  </div>
  <div class="adm-stat adm-stat-purple">
    <div class="adm-stat-icon"><i data-lucide="phone-call"></i></div>
    <div>
      <div class="adm-stat-val"><%= totals.contacted_count || 0 %></div>
      <div class="adm-stat-lbl">ติดต่อแล้ว</div>
      <div class="adm-stat-sub">จาก <%= totals.total_leads || 0 %> leads</div>
    </div>
  </div>
  <div class="adm-stat adm-stat-orange">
    <div class="adm-stat-icon"><i data-lucide="trophy"></i></div>
    <div>
      <div class="adm-stat-val"><%= totals.converted_count || 0 %></div>
      <div class="adm-stat-lbl">ปิดงานสำเร็จ</div>
      <% const convRate = totals.total_leads > 0 ? Math.round(totals.converted_count/totals.total_leads*100) : 0 %>
      <div class="adm-stat-sub">Conversion <%= convRate %>%</div>
    </div>
  </div>
</div>

<!-- FUNNEL STAGE -->
<div class="adm-card adm-card-full adm-funnel-card">
  <div class="adm-card-header">
    <div class="adm-card-title">🔥 Funnel Stage</div>
    <a href="/admin/leads" class="adm-link-btn">ดูทั้งหมด →</a>
  </div>
  <div class="adm-funnel-stages">
    <a href="/admin/leads?funnel_stage=cold" class="adm-funnel-stage adm-funnel-cold">
      <div class="adm-funnel-icon"><i data-lucide="eye"></i></div>
      <div class="adm-funnel-val"><%= totals.cold_count || 0 %></div>
      <div class="adm-funnel-lbl">แวะดู</div>
      <div class="adm-funnel-sub">เข้ามาดู/กรอกนิดหน่อย</div>
    </a>
    <div class="adm-funnel-arrow">→</div>
    <a href="/admin/leads?funnel_stage=warm" class="adm-funnel-stage adm-funnel-warm">
      <div class="adm-funnel-icon"><i data-lucide="clock"></i></div>
      <div class="adm-funnel-val"><%= totals.warm_count || 0 %></div>
      <div class="adm-funnel-lbl">กำลังคิด</div>
      <div class="adm-funnel-sub">กรอกครึ่งทาง แล้วออก</div>
    </a>
    <div class="adm-funnel-arrow">→</div>
    <a href="/admin/leads?funnel_stage=hot" class="adm-funnel-stage adm-funnel-hot">
      <div class="adm-funnel-icon"><i data-lucide="flame"></i></div>
      <div class="adm-funnel-val"><%= totals.hot_count || 0 %></div>
      <div class="adm-funnel-lbl">พร้อมซื้อ</div>
      <div class="adm-funnel-sub">กรอกครบ เห็นราคาแล้ว</div>
    </a>
  </div>
</div>

<!-- CHARTS -->
<div class="adm-charts">
  <!-- Daily Bar Chart -->
  <div class="adm-card">
    <div class="adm-card-title">📊 Leads 7 วันล่าสุด</div>
    <div class="adm-bar-chart">
      <% if (!dailyStats.length) { %><div class="adm-empty">ยังไม่มีข้อมูล</div><% } %>
      <% const maxCnt = Math.max(...dailyStats.map(d=>d.cnt), 1) %>
      <% dailyStats.forEach(d => { %>
        <div class="adm-bar-group">
          <div class="adm-bar-track">
            <div class="adm-bar-fill" style="height:<%= Math.round(d.cnt/maxCnt*100) %>%">
              <span class="adm-bar-val"><%= d.cnt %></span>
            </div>
          </div>
          <div class="adm-bar-lbl"><%= new Date(d.day).toLocaleDateString('th-TH',{day:'numeric',month:'short'}) %></div>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Donut Chart -->
  <div class="adm-card">
    <div class="adm-card-title">🥧 สัดส่วนประเภทประกัน</div>
    <% const totalCnt = typeBreakdown.reduce((s,t)=>s+parseInt(t.cnt),0)||1 %>
    <% if (!typeBreakdown.length) { %><div class="adm-empty">ยังไม่มีข้อมูล</div><% } %>
    <% const colors={class1:'#1a56db',class2plus:'#7c3aed',class3plus:'#059669'} %>
    <%
      let off=0;
      const segs=typeBreakdown.map(t=>{
        const pct=parseInt(t.cnt)/totalCnt*100;
        const s={type:t.insurance_type,pct,off,cnt:t.cnt,color:colors[t.insurance_type]||'#94a3b8'};
        off+=pct; return s;
      })
    %>
    <div class="adm-donut-wrap">
      <svg viewBox="0 0 36 36" class="adm-donut">
        <% segs.forEach(s=>{ %>
          <circle cx="18" cy="18" r="15.9" fill="transparent" stroke="<%= s.color %>" stroke-width="3.8"
            stroke-dasharray="<%= s.pct.toFixed(1) %> <%= (100-s.pct).toFixed(1) %>"
            stroke-dashoffset="<%= (25-s.off+100).toFixed(1) %>"/>
        <% }) %>
        <text x="18" y="19" text-anchor="middle" class="adm-donut-txt"><%= totalCnt %></text>
      </svg>
    </div>
    <div class="adm-legend">
      <% typeBreakdown.forEach(t=>{ %>
        <div class="adm-legend-row">
          <span class="adm-legend-dot" style="background:<%= colors[t.insurance_type]||'#94a3b8' %>"></span>
          <span class="adm-legend-lbl"><%= TYPE_MAP[t.insurance_type]||t.insurance_type %></span>
          <span class="adm-legend-cnt"><%= t.cnt %> (<%= Math.round(parseInt(t.cnt)/totalCnt*100) %>%)</span>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Top Brands -->
  <div class="adm-card">
    <div class="adm-card-header">
      <div class="adm-card-title">ยี่ห้อยอดนิยม</div>
      <a href="/admin/reports" class="adm-link-btn" style="font-size:.78rem">ดูรายงาน →</a>
    </div>
    <% if (!topBrands.length) { %><div class="adm-empty">ยังไม่มีข้อมูล</div><% } %>
    <% const maxB=Math.max(...topBrands.map(b=>b.cnt),1) %>
    <div class="adm-hbars">
      <% topBrands.forEach((b,i)=>{ %>
        <div class="adm-hbar-row">
          <span class="adm-hbar-lbl">
            <span class="adm-rank-badge adm-rank-<%= i+1 %>">#<%= i+1 %></span>
            <%= b.car_brand %>
          </span>
          <div class="adm-hbar-track">
            <div class="adm-hbar-fill adm-hbar-purple" style="width:<%= Math.round(b.cnt/maxB*100) %>%"></div>
          </div>
          <span class="adm-hbar-val"><%= b.cnt %></span>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<!-- RECENT LEADS -->
<div class="adm-card adm-card-full">
  <div class="adm-card-header">
    <div class="adm-card-title">📞 Leads ล่าสุด</div>
    <a href="/admin/leads" class="adm-link-btn">ดูทั้งหมด →</a>
  </div>
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead><tr>
        <th>รถ</th><th>ประกัน</th><th>ราคา</th><th>ลูกค้า</th><th>CTA</th><th>แหล่ง</th><th>สถานะ</th><th>วันที่</th>
      </tr></thead>
      <tbody>
        <% if (!recentLeads.length) { %><tr><td colspan="8" class="adm-empty-cell">ยังไม่มี leads</td></tr><% } %>
        <% recentLeads.forEach(l=>{ %>
          <tr>
            <td><div class="adm-name"><%= l.brand %> <%= l.model %></div><div class="adm-sub">ปี <%= l.year %></div></td>
            <td><span class="adm-type-pill adm-type-<%= l.insurance_type %>"><%= TYPE_MAP[l.insurance_type] %></span></td>
            <td class="adm-money"><% if(l.best_price){ %>฿<%= formatNumber(l.best_price) %><% }else{ %>-<% } %></td>
            <td>
              <% if(l.name){ %><div class="adm-name"><%= l.name %></div><% } %>
              <% if(l.phone){ %><div class="adm-sub"><%= l.phone %></div><% } %>
              <% if(!l.name && !l.phone){ %><div class="adm-sub">ไม่ระบุ</div><% } %>
            </td>
            <td>
              <% if(l.clicked_line){ %><span class="adm-click-badge adm-click-line">LINE ✓</span> <% } %>
              <% if(l.clicked_facebook){ %><span class="adm-click-badge adm-click-fb">FB ✓</span><% } %>
            </td>
            <td class="adm-sub"><%= SOURCE_MAP[l.source]||l.source %></td>
            <td><span class="adm-status adm-status-<%= l.status %>"><%= LEAD_STATUS_MAP[l.status]||l.status %></span></td>
            <td class="adm-dt"><%= new Date(l.created_at).toLocaleDateString('th-TH',{day:'numeric',month:'short'}) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
