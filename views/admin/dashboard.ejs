<% if (admin.role === 'affiliate') { %>
<div class="adm-card adm-card-full" style="margin-bottom:16px;background:linear-gradient(135deg,#7c3aed,#5b21b6);color:#fff">
  <div style="display:flex;gap:32px;flex-wrap:wrap;padding:4px 0;align-items:center">
    <div>
      <div style="font-size:24px;font-weight:700">฿<%= formatNumber(totals.pending_commission||0) %></div>
      <div style="opacity:.8;font-size:13px">Commission ค้างจ่าย</div>
    </div>
    <div>
      <div style="font-size:24px;font-weight:700">฿<%= formatNumber(totals.paid_commission||0) %></div>
      <div style="opacity:.8;font-size:13px">จ่ายแล้วทั้งหมด</div>
    </div>
    <div>
      <div style="font-size:24px;font-weight:700"><%= totals.converted_count||0 %></div>
      <div style="opacity:.8;font-size:13px">Leads ปิดงานสำเร็จ</div>
    </div>
    <% if (affSlug) { %>
    <div style="margin-left:auto">
      <div style="font-size:11px;opacity:.7;margin-bottom:4px">ลิงก์ของคุณ</div>
      <div style="display:flex;align-items:center;gap:8px">
        <span id="affLinkText" style="font-size:12px;background:rgba(255,255,255,.15);padding:5px 10px;border-radius:6px;font-family:monospace;max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= appUrl %>/?aff=<%= affSlug %></span>
        <button onclick="copyAffLink()" id="copyBtn" style="background:rgba(255,255,255,.25);border:none;color:#fff;cursor:pointer;padding:5px 12px;border-radius:6px;font-size:12px;white-space:nowrap">คัดลอก</button>
      </div>
    </div>
    <% } %>
  </div>
</div>
<script>
function copyAffLink() {
  const url = document.getElementById('affLinkText').textContent.trim()
  navigator.clipboard.writeText(url).then(() => {
    const btn = document.getElementById('copyBtn')
    btn.textContent = '✓ คัดลอกแล้ว'
    setTimeout(() => { btn.textContent = 'คัดลอก' }, 2000)
  })
}
</script>
<% } %>

<!-- FUNNEL STATS -->
<div class="adm-stats">
  <div class="adm-stat adm-stat-blue">
    <div class="adm-stat-icon"><i data-lucide="clipboard-list"></i></div>
    <div>
      <div class="adm-stat-val"><%= totals.today_leads || 0 %></div>
      <div class="adm-stat-lbl">Leads วันนี้</div>
      <div class="adm-stat-sub">เดือนนี้ <%= totals.month_leads || 0 %> leads</div>
    </div>
  </div>
  <div class="adm-stat adm-stat-green">
    <div class="adm-stat-icon"><i data-lucide="mouse-pointer-click"></i></div>
    <div>
      <div class="adm-stat-val"><%= totals.total_clicked || 0 %></div>
      <div class="adm-stat-lbl">คลิก LINE / FB</div>
      <div class="adm-stat-sub">LINE <%= totals.total_line_clicks||0 %> · FB <%= totals.total_fb_clicks||0 %></div>
    </div>
  </div>
  <div class="adm-stat adm-stat-purple">
    <div class="adm-stat-icon"><i data-lucide="phone-call"></i></div>
    <div>
      <div class="adm-stat-val"><%= totals.contacted_count || 0 %></div>
      <div class="adm-stat-lbl">ติดต่อแล้ว</div>
      <div class="adm-stat-sub">จาก <%= totals.total_leads || 0 %> leads</div>
    </div>
  </div>
  <div class="adm-stat adm-stat-orange">
    <div class="adm-stat-icon"><i data-lucide="trophy"></i></div>
    <div>
      <div class="adm-stat-val"><%= totals.converted_count || 0 %></div>
      <div class="adm-stat-lbl">ปิดงานสำเร็จ</div>
      <% const convRate = totals.total_leads > 0 ? Math.round(totals.converted_count/totals.total_leads*100) : 0 %>
      <div class="adm-stat-sub">Conversion <%= convRate %>%</div>
    </div>
  </div>
</div>

<!-- FUNNEL STAGE -->
<div class="adm-card adm-card-full adm-funnel-card">
  <div class="adm-card-header">
    <div class="adm-card-title">🔥 Funnel Stage</div>
    <a href="/admin/leads" class="adm-link-btn">ดูทั้งหมด →</a>
  </div>
  <div class="adm-funnel-stages">
    <a href="/admin/leads?funnel_stage=cold" class="adm-funnel-stage adm-funnel-cold">
      <div class="adm-funnel-icon"><i data-lucide="eye"></i></div>
      <div class="adm-funnel-val"><%= totals.cold_count || 0 %></div>
      <div class="adm-funnel-lbl">แวะดู</div>
      <div class="adm-funnel-sub">เข้ามาดู/กรอกนิดหน่อย</div>
    </a>
    <div class="adm-funnel-arrow">→</div>
    <a href="/admin/leads?funnel_stage=warm" class="adm-funnel-stage adm-funnel-warm">
      <div class="adm-funnel-icon"><i data-lucide="clock"></i></div>
      <div class="adm-funnel-val"><%= totals.warm_count || 0 %></div>
      <div class="adm-funnel-lbl">กำลังคิด</div>
      <div class="adm-funnel-sub">กรอกครึ่งทาง แล้วออก</div>
    </a>
    <div class="adm-funnel-arrow">→</div>
    <a href="/admin/leads?funnel_stage=hot" class="adm-funnel-stage adm-funnel-hot">
      <div class="adm-funnel-icon"><i data-lucide="flame"></i></div>
      <div class="adm-funnel-val"><%= totals.hot_count || 0 %></div>
      <div class="adm-funnel-lbl">พร้อมซื้อ</div>
      <div class="adm-funnel-sub">กรอกครบ เห็นราคาแล้ว</div>
    </a>
  </div>
</div>

<!-- CHARTS -->
<div class="adm-charts">

  <!-- Daily Bar Chart -->
  <div class="adm-card">
    <div class="adm-card-title">📊 Leads 7 วันล่าสุด</div>
    <% if (!dailyStats.length) { %><div class="adm-empty">ยังไม่มีข้อมูล</div><% } else { %>
    <div style="height:180px;margin-top:8px"><canvas id="dashChartDaily"></canvas></div>
    <% } %>
  </div>

  <!-- Donut Chart -->
  <div class="adm-card">
    <div class="adm-card-title">🥧 สัดส่วนประเภทประกัน</div>
    <% if (!typeBreakdown.length) { %><div class="adm-empty">ยังไม่มีข้อมูล</div><% } else { %>
    <div style="height:180px;margin-top:8px"><canvas id="dashChartType"></canvas></div>
    <div id="dashLegendType" style="display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:10px"></div>
    <% } %>
  </div>

  <!-- Top Brands -->
  <div class="adm-card">
    <div class="adm-card-header">
      <div class="adm-card-title">ยี่ห้อยอดนิยม</div>
      <a href="/admin/reports" class="adm-link-btn" style="font-size:.78rem">ดูรายงาน →</a>
    </div>
    <% if (!topBrands.length) { %><div class="adm-empty">ยังไม่มีข้อมูล</div><% } else { %>
    <div style="height:<%= Math.max(140, topBrands.length * 30) %>px;margin-top:8px"><canvas id="dashChartBrands"></canvas></div>
    <% } %>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
;(function(){
  Chart.defaults.font.family = "'Sarabun','Inter',sans-serif"
  Chart.defaults.font.size = 11.5
  Chart.defaults.color = '#94a3b8'

  const PALETTE = ['#3b82f6','#10b981','#8b5cf6','#f59e0b','#ec4899','#14b8a6','#f97316','#6366f1']
  const TYPE_COLOR = { class1:'#3b82f6', class2plus:'#8b5cf6', class3plus:'#10b981', compulsory:'#f59e0b' }
  const TYPE_MAP_JS = <%- JSON.stringify(TYPE_MAP) %>

  const dailyStats  = <%- JSON.stringify(dailyStats) %>
  const typeBreakdown = <%- JSON.stringify(typeBreakdown) %>
  const topBrands   = <%- JSON.stringify(topBrands) %>

  const tooltipDefaults = {
    backgroundColor: '#1e293b', titleColor: '#f1f5f9', bodyColor: '#cbd5e1',
    borderColor: '#334155', borderWidth: 1, cornerRadius: 8, padding: 10
  }

  // ── Daily Bar ──────────────────────────────────────────────
  ;(function(){
    const el = document.getElementById('dashChartDaily')
    if (!el || !dailyStats.length) return
    new Chart(el, {
      type: 'bar',
      data: {
        labels: dailyStats.map(d => {
          const dt = new Date(d.day)
          return (dt.getDate()) + '/' + (dt.getMonth()+1)
        }),
        datasets: [{
          label: 'Leads',
          data: dailyStats.map(d => d.cnt),
          backgroundColor: '#3b82f6',
          borderRadius: 6,
          borderSkipped: false,
          maxBarThickness: 36
        }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { ...tooltipDefaults, callbacks: { label: ctx => ` ${ctx.parsed.y} leads` } } },
        scales: {
          x: { grid: { display: false }, border: { display: false } },
          y: { grid: { color: '#f1f5f9' }, border: { display: false }, ticks: { precision: 0 }, beginAtZero: true }
        }
      }
    })
  })()

  // ── Type Donut ─────────────────────────────────────────────
  ;(function(){
    const el = document.getElementById('dashChartType')
    if (!el || !typeBreakdown.length) return
    const labels = typeBreakdown.map(t => TYPE_MAP_JS[t.insurance_type] || t.insurance_type)
    const data   = typeBreakdown.map(t => t.cnt)
    const colors = typeBreakdown.map(t => TYPE_COLOR[t.insurance_type] || '#94a3b8')
    const total  = data.reduce((a,b) => a + parseInt(b), 0)

    new Chart(el, {
      type: 'doughnut',
      data: { labels, datasets: [{ data, backgroundColor: colors, borderWidth: 2, borderColor: '#fff', hoverOffset: 6 }] },
      options: {
        responsive: true, maintainAspectRatio: false, cutout: '68%',
        plugins: {
          legend: { display: false },
          tooltip: { ...tooltipDefaults, callbacks: { label: ctx => ` ${ctx.label}: ${ctx.parsed} (${Math.round(ctx.parsed/total*100)}%)` } }
        }
      }
    })

    const wrap = document.getElementById('dashLegendType')
    if (wrap) wrap.innerHTML = labels.map((l,i) =>
      `<div style="display:flex;align-items:center;gap:5px;font-size:11px;color:#64748b">
        <span style="width:9px;height:9px;border-radius:50%;background:${colors[i]};flex-shrink:0"></span>
        ${l} <strong style="color:#334155">${data[i]}</strong>
      </div>`
    ).join('')
  })()

  // ── Top Brands Horizontal ─────────────────────────────────
  ;(function(){
    const el = document.getElementById('dashChartBrands')
    if (!el || !topBrands.length) return
    new Chart(el, {
      type: 'bar',
      data: {
        labels: topBrands.map((b,i) => `#${i+1} ${b.car_brand||'ไม่ระบุ'}`),
        datasets: [{
          label: 'Leads',
          data: topBrands.map(b => b.cnt),
          backgroundColor: topBrands.map((_,i) => PALETTE[i % PALETTE.length] + 'cc'),
          borderColor:      topBrands.map((_,i) => PALETTE[i % PALETTE.length]),
          borderWidth: 1.5,
          borderRadius: 5,
          borderSkipped: false,
          maxBarThickness: 20
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { ...tooltipDefaults, callbacks: { label: ctx => ` ${ctx.parsed.x} leads` } } },
        scales: {
          x: { grid: { color: '#f1f5f9' }, border: { display: false }, ticks: { precision: 0 } },
          y: { grid: { display: false }, border: { display: false }, ticks: { font: { size: 12, weight: '600' }, color: '#475569' } }
        }
      }
    })
  })()

})()
</script>

<!-- RECENT LEADS -->
<div class="adm-card adm-card-full">
  <div class="adm-card-header">
    <div class="adm-card-title">📞 Leads ล่าสุด</div>
    <a href="/admin/leads" class="adm-link-btn">ดูทั้งหมด →</a>
  </div>
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead><tr>
        <th>รถ</th><th>ประกัน</th><th>ราคา</th><th>ลูกค้า</th><th>CTA</th><th>แหล่ง</th><th>สถานะ</th><th>วันที่</th>
      </tr></thead>
      <tbody>
        <% if (!recentLeads.length) { %><tr><td colspan="8" class="adm-empty-cell">ยังไม่มี leads</td></tr><% } %>
        <% recentLeads.forEach(l=>{ %>
          <tr>
            <td><div class="adm-name"><%= l.brand %> <%= l.model %></div><div class="adm-sub">ปี <%= l.year %></div></td>
            <td><span class="adm-type-pill adm-type-<%= l.insurance_type %>"><%= TYPE_MAP[l.insurance_type] %></span></td>
            <td class="adm-money"><% if(l.best_price){ %>฿<%= formatNumber(l.best_price) %><% }else{ %>-<% } %></td>
            <td>
              <% if(l.name){ %><div class="adm-name"><%= l.name %></div><% } %>
              <% if(l.phone){ %><div class="adm-sub"><%= l.phone %></div><% } %>
              <% if(!l.name && !l.phone){ %><div class="adm-sub">ไม่ระบุ</div><% } %>
            </td>
            <td>
              <% if(l.clicked_line){ %><span class="adm-click-badge adm-click-line">LINE ✓</span> <% } %>
              <% if(l.clicked_facebook){ %><span class="adm-click-badge adm-click-fb">FB ✓</span><% } %>
            </td>
            <td class="adm-sub"><%= SOURCE_MAP[l.source]||l.source %></td>
            <td><span class="adm-status adm-status-<%= l.status %>"><%= LEAD_STATUS_MAP[l.status]||l.status %></span></td>
            <td class="adm-dt"><%= new Date(l.created_at).toLocaleDateString('th-TH',{day:'numeric',month:'short'}) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
