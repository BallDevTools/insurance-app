<!-- FILTER -->
<div class="adm-card adm-filter-card">
  <form action="/admin/leads" method="GET" class="adm-filter-form">
    <input type="text" name="q" value="<%= filters.q %>" placeholder="🔍 ค้นหา ชื่อ / เบอร์ / ยี่ห้อ / ทะเบียน">
    <select name="status">
      <option value="">ทุกสถานะ</option>
      <option value="new"       <%= filters.status==='new'?'selected':'' %>>ใหม่</option>
      <option value="contacted" <%= filters.status==='contacted'?'selected':'' %>>ติดต่อแล้ว</option>
      <option value="converted" <%= filters.status==='converted'?'selected':'' %>>ปิดงาน</option>
      <option value="lost"      <%= filters.status==='lost'?'selected':'' %>>ยกเลิก</option>
    </select>
    <select name="source">
      <option value="">ทุกแหล่ง</option>
      <option value="organic"      <%= filters.source==='organic'?'selected':'' %>>Organic</option>
      <option value="line_ads"     <%= filters.source==='line_ads'?'selected':'' %>>LINE Ads</option>
      <option value="facebook_ads" <%= filters.source==='facebook_ads'?'selected':'' %>>Facebook Ads</option>
      <option value="google"       <%= filters.source==='google'?'selected':'' %>>Google</option>
    </select>
    <button type="submit" class="adm-btn adm-btn-primary">ค้นหา</button>
    <a href="/admin/leads" class="adm-btn adm-btn-ghost">ล้าง</a>
  </form>
</div>

<!-- TABLE -->
<div class="adm-card adm-card-full">
  <div class="adm-card-header">
    <div class="adm-card-title">Leads ทั้งหมด <span class="adm-badge"><%= total %></span></div>
  </div>
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead><tr>
        <th>รถ / ประกัน</th>
        <th>ราคา</th>
        <th>ลูกค้า</th>
        <th>CTA</th>
        <th>แหล่ง</th>
        <th>สถานะ</th>
        <th>วันที่</th>
        <th>Action</th>
      </tr></thead>
      <tbody>
        <% if (!leads.length) { %>
          <tr><td colspan="8" class="adm-empty-cell">ไม่พบข้อมูล</td></tr>
        <% } %>
        <% leads.forEach(l=>{ %>
          <tr>
            <td>
              <div><strong><%= l.brand %> <%= l.model %></strong></div>
              <div class="adm-sub">ปี <%= l.year %> · <%= l.province %></div>
              <div><span class="adm-type-pill adm-type-<%= l.insurance_type %>"><%= TYPE_MAP[l.insurance_type] %></span></div>
            </td>
            <td class="adm-money">
              <% if (l.best_price) { %>฿<%= formatNumber(l.best_price) %><% } else { %>-<% } %>
            </td>
            <td>
              <% if (l.name) { %><div class="adm-name"><%= l.name %></div><% } else { %><div class="adm-sub">ไม่ระบุชื่อ</div><% } %>
              <% if (l.phone) { %><div><a href="tel:<%= l.phone %>" class="adm-phone"><%= l.phone %></a></div><% } %>
            </td>
            <td>
              <% if (l.clicked_line) { %><span class="adm-click-badge adm-click-line" title="คลิก LINE">LINE ✓</span> <% } %>
              <% if (l.clicked_facebook) { %><span class="adm-click-badge adm-click-fb" title="คลิก Facebook">FB ✓</span><% } %>
              <% if (!l.clicked_line && !l.clicked_facebook) { %><span class="adm-sub">ยังไม่คลิก</span><% } %>
            </td>
            <td>
              <div><%= SOURCE_MAP[l.source] || l.source %></div>
              <% if (l.utm_campaign) { %><div class="adm-sub"><%= l.utm_campaign %></div><% } %>
            </td>
            <td><span class="adm-status adm-status-<%= l.status %>"><%= LEAD_STATUS_MAP[l.status] || l.status %></span></td>
            <td class="adm-dt"><%= new Date(l.created_at).toLocaleDateString('th-TH',{day:'numeric',month:'short',year:'2-digit'}) %></td>
            <td>
              <form action="/admin/leads/<%= l.id %>/status" method="POST" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <select name="status" onchange="this.form.submit()" class="adm-inline-select">
                  <option value="new"       <%= l.status==='new'?'selected':'' %>>ใหม่</option>
                  <option value="contacted" <%= l.status==='contacted'?'selected':'' %>>ติดต่อ</option>
                  <option value="converted" <%= l.status==='converted'?'selected':'' %>>ปิดงาน</option>
                  <option value="lost"      <%= l.status==='lost'?'selected':'' %>>ยกเลิก</option>
                </select>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (totalPages > 1) { %>
    <div class="adm-pagination">
      <% for (let i=1; i<=totalPages; i++) { %>
        <a href="?page=<%= i %>&q=<%= filters.q %>&status=<%= filters.status %>&source=<%= filters.source %>"
           class="adm-page-btn <%= page===i?'active':'' %>"><%= i %></a>
      <% } %>
    </div>
  <% } %>
</div>
