<!-- LINE Sessions Admin Page -->
<div class="adm-page-header">
  <h1 class="adm-page-title">💬 LINE Chat</h1>
  <div class="adm-page-actions">
    <span class="adm-badge adm-badge-warning" id="handoff-count">
      Handoff: <%= sessions.filter(s => s.state === 'handoff').length %>
    </span>
  </div>
</div>

<div class="line-chat-layout">
  <!-- ====== SESSION LIST ====== -->
  <div class="line-session-list" id="sessionList">
    <div class="line-session-search">
      <input type="text" id="sessionSearch" placeholder="🔍 ค้นหาชื่อ..." oninput="filterSessions(this.value)">
      <select id="stateFilter" onchange="filterSessions()">
        <option value="">ทุกสถานะ</option>
        <option value="handoff">Handoff</option>
        <option value="bot">Bot</option>
      </select>
    </div>

    <% sessions.forEach(s => { %>
    <div class="line-session-item <%= s.state === 'handoff' ? 'handoff' : '' %>"
         data-user="<%= s.line_user_id %>"
         data-name="<%= s.display_name %>"
         data-state="<%= s.state %>"
         onclick="loadChat('<%= s.line_user_id %>', '<%= s.display_name %>', '<%= s.state %>', '<%= s.picture_url || '' %>')">
      <div class="line-avatar">
        <% if (s.picture_url) { %>
          <img src="<%= s.picture_url %>" alt="">
        <% } else { %>
          <span><%= (s.display_name||'?').charAt(0) %></span>
        <% } %>
      </div>
      <div class="line-session-info">
        <div class="line-session-name"><%= s.display_name || 'ไม่ทราบชื่อ' %></div>
        <div class="line-session-last"><%= s.last_message ? s.last_message.substring(0,40) + (s.last_message.length > 40 ? '...' : '') : '—' %></div>
      </div>
      <div class="line-session-meta">
        <span class="line-state-badge <%= s.state %>"><%= s.state === 'handoff' ? '⚠️ Handoff' : '🤖 Bot' %></span>
        <div class="line-session-time"><%= new Date(s.updated_at).toLocaleString('th-TH', {hour:'2-digit',minute:'2-digit'}) %></div>
      </div>
    </div>
    <% }) %>

    <% if (sessions.length === 0) { %>
    <div style="padding:2rem;text-align:center;color:var(--text-muted)">ยังไม่มีผู้ใช้ LINE</div>
    <% } %>
  </div>

  <!-- ====== CHAT PANEL ====== -->
  <div class="line-chat-panel" id="chatPanel">
    <div class="line-chat-empty" id="chatEmpty">
      <div style="font-size:3rem">💬</div>
      <div>เลือก session เพื่อดูประวัติการสนทนา</div>
    </div>

    <!-- Chat Header -->
    <div class="line-chat-header" id="chatHeader" style="display:none">
      <div class="line-chat-user">
        <div class="line-avatar sm" id="chatAvatar"><span id="chatInitial">?</span></div>
        <div>
          <div class="line-chat-name" id="chatName">—</div>
          <div id="chatStateBadge" class="line-state-badge bot">🤖 Bot</div>
        </div>
      </div>
      <div class="line-chat-actions">
        <button class="adm-btn adm-btn-primary" id="btnHandoff" onclick="setHandoff()" style="display:none">⚠️ รับ Handoff</button>
        <button class="adm-btn adm-btn-success" id="btnReturnBot" onclick="returnToBot()" style="display:none">🤖 ส่งกลับ Bot</button>
      </div>
    </div>

    <!-- Messages -->
    <div class="line-messages" id="chatMessages"></div>

    <!-- Input -->
    <div class="line-chat-input" id="chatInput" style="display:none">
      <textarea id="msgText" placeholder="พิมพ์ข้อความ... (Enter ส่ง, Shift+Enter ขึ้นบรรทัด)"
        onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendMessage()}"></textarea>
      <button class="adm-btn adm-btn-primary" onclick="sendMessage()">ส่ง ➤</button>
    </div>
  </div>
</div>

<!-- ====== STYLES ====== -->
<style>
.line-chat-layout {
  display: grid;
  grid-template-columns: 320px 1fr;
  gap: 0;
  height: calc(100vh - 180px);
  background: #fff;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--gray-100);
}
.line-session-list {
  border-right: 1px solid var(--gray-100);
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}
.line-session-search {
  padding: .75rem;
  display: flex;
  gap: .5rem;
  border-bottom: 1px solid var(--gray-100);
  position: sticky;
  top: 0;
  background: #fff;
  z-index: 1;
}
.line-session-search input, .line-session-search select {
  padding: .4rem .6rem;
  border: 1.5px solid var(--gray-200);
  border-radius: var(--radius-sm);
  font-size: .85rem;
  background: #fff;
  color: var(--gray-800);
  font-family: inherit;
  outline: none;
}
.line-session-search input:focus, .line-session-search select:focus { border-color: var(--adm-accent); }
.line-session-search input { flex: 1 }
.line-session-item {
  display: flex;
  align-items: center;
  gap: .75rem;
  padding: .75rem 1rem;
  cursor: pointer;
  border-bottom: 1px solid var(--gray-100);
  transition: background .15s;
}
.line-session-item:hover { background: var(--gray-50) }
.line-session-item.active { background: #eff6ff }
.line-session-item.handoff { border-left: 3px solid #f59e0b }
.line-avatar {
  width: 42px; height: 42px;
  border-radius: 50%;
  background: var(--adm-accent);
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-weight: 700;
  overflow: hidden; flex-shrink: 0;
}
.line-avatar img { width: 100%; height: 100%; object-fit: cover }
.line-avatar.sm { width: 34px; height: 34px; font-size: .8rem }
.line-session-info { flex: 1; min-width: 0 }
.line-session-name { font-weight: 600; font-size: .9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--gray-800); }
.line-session-last { font-size: .8rem; color: var(--gray-400); white-space: nowrap; overflow: hidden; text-overflow: ellipsis }
.line-session-meta { text-align: right; flex-shrink: 0 }
.line-session-time { font-size: .75rem; color: var(--gray-400); margin-top: .25rem }
.line-state-badge { font-size: .72rem; padding: .15rem .4rem; border-radius: 10px; white-space: nowrap }
.line-state-badge.handoff { background: #fef3c7; color: #92400e }
.line-state-badge.bot { background: #dbeafe; color: #1e40af }
/* Chat panel */
.line-chat-panel { display: flex; flex-direction: column; height: 100% }
.line-chat-empty { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--gray-400); gap: 1rem }
.line-chat-header { display: flex; align-items: center; justify-content: space-between; padding: .75rem 1rem; border-bottom: 1px solid var(--gray-100) }
.line-chat-user { display: flex; align-items: center; gap: .75rem }
.line-chat-name { font-weight: 700; color: var(--gray-800); }
.line-chat-actions { display: flex; gap: .5rem }
.line-messages { flex: 1; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: .75rem; background: var(--gray-50); }
.msg-row { display: flex; gap: .5rem; max-width: 75% }
.msg-row.in { align-self: flex-start }
.msg-row.out { align-self: flex-end; flex-direction: row-reverse }
.msg-bubble { padding: .6rem .9rem; border-radius: 16px; font-size: .9rem; line-height: 1.5; word-break: break-word }
.msg-row.in .msg-bubble { background: #fff; border: 1px solid var(--gray-200); border-radius: 4px 16px 16px 16px }
.msg-row.out .msg-bubble { background: var(--adm-accent); color: #fff; border-radius: 16px 4px 16px 16px }
.msg-meta { font-size: .72rem; color: var(--gray-400); margin-top: .15rem; text-align: right }
.msg-row.in .msg-meta { text-align: left }
.line-chat-input { display: flex; gap: .5rem; padding: .75rem; border-top: 1px solid var(--gray-100); background: #fff; }
.line-chat-input textarea { flex: 1; resize: none; height: 60px; padding: .5rem .75rem; border: 1.5px solid var(--gray-200); border-radius: var(--radius-sm); font-size: .9rem; font-family: inherit; background: #fff; color: var(--gray-800); outline: none; }
.line-chat-input textarea:focus { border-color: var(--adm-accent); }
</style>

<!-- ====== SCRIPTS ====== -->
<script>
let currentUserId = null
let currentState = null

function filterSessions(val) {
  const q = (document.getElementById('sessionSearch').value||'').toLowerCase()
  const st = document.getElementById('stateFilter').value
  document.querySelectorAll('.line-session-item').forEach(el => {
    const nameMatch = el.dataset.name.toLowerCase().includes(q)
    const stateMatch = !st || el.dataset.state === st
    el.style.display = (nameMatch && stateMatch) ? '' : 'none'
  })
}

async function loadChat(userId, name, state, pic) {
  currentUserId = userId
  currentState = state

  document.querySelectorAll('.line-session-item').forEach(el => el.classList.remove('active'))
  document.querySelector(`[data-user="${userId}"]`)?.classList.add('active')

  document.getElementById('chatEmpty').style.display = 'none'
  document.getElementById('chatHeader').style.display = 'flex'
  document.getElementById('chatInput').style.display = 'flex'
  document.getElementById('chatName').textContent = name
  document.getElementById('chatInitial').textContent = name.charAt(0)

  const badge = document.getElementById('chatStateBadge')
  badge.className = 'line-state-badge ' + state
  badge.textContent = state === 'handoff' ? '⚠️ Handoff' : '🤖 Bot'

  document.getElementById('btnHandoff').style.display = state === 'bot' ? '' : 'none'
  document.getElementById('btnReturnBot').style.display = state === 'handoff' ? '' : 'none'
  // input เปิดเสมอ แต่ถ้า bot อยู่ ให้ admin ส่งได้ (push message)

  const avatarEl = document.getElementById('chatAvatar')
  if (pic) {
    avatarEl.innerHTML = `<img src="${pic}" alt="">`
  } else {
    avatarEl.innerHTML = `<span>${name.charAt(0)}</span>`
  }

  await refreshMessages()
}

async function refreshMessages() {
  if (!currentUserId) return
  const res = await fetch(`/admin/line/messages?userId=${currentUserId}`)
  const msgs = await res.json()
  const container = document.getElementById('chatMessages')
  container.innerHTML = msgs.map(m => `
    <div class="msg-row ${m.direction}">
      <div>
        <div class="msg-bubble">${escHtml(m.message)}</div>
        <div class="msg-meta">${m.sent_by} · ${new Date(m.created_at).toLocaleTimeString('th-TH',{hour:'2-digit',minute:'2-digit'})}</div>
      </div>
    </div>
  `).join('')
  container.scrollTop = container.scrollHeight
}

async function sendMessage() {
  const text = document.getElementById('msgText').value.trim()
  if (!text || !currentUserId) return
  document.getElementById('msgText').value = ''

  await fetch('/admin/line/send', {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ userId: currentUserId, message: text })
  })
  await refreshMessages()
}

async function setHandoff() {
  if (!currentUserId) return
  await fetch('/admin/line/state', {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ userId: currentUserId, state: 'handoff' })
  })
  currentState = 'handoff'
  document.getElementById('btnHandoff').style.display = 'none'
  document.getElementById('btnReturnBot').style.display = ''
  document.getElementById('chatStateBadge').className = 'line-state-badge handoff'
  document.getElementById('chatStateBadge').textContent = '⚠️ Handoff'
}

async function returnToBot() {
  if (!currentUserId) return
  await fetch('/admin/line/state', {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ userId: currentUserId, state: 'bot' })
  })
  currentState = 'bot'
  document.getElementById('btnHandoff').style.display = ''
  document.getElementById('btnReturnBot').style.display = 'none'
  document.getElementById('chatStateBadge').className = 'line-state-badge bot'
  document.getElementById('chatStateBadge').textContent = '🤖 Bot'

  // แจ้ง user ว่ากลับมาใช้ bot แล้ว
  await fetch('/admin/line/send', {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ userId: currentUserId, message: 'เจ้าหน้าที่ได้ส่งกลับระบบ Bot แล้วครับ หากมีคำถามเพิ่มเติมพิมพ์ได้เลย 🤖' })
  })
  await refreshMessages()
}

function escHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>')
}

// auto-refresh ทุก 10 วินาที
setInterval(() => { if (currentUserId) refreshMessages() }, 10000)

// mark LINE notifications as read เมื่อเปิดหน้านี้
fetch('/admin/api/notifications/read', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ type: 'new_line_message' })
}).catch(() => {})
</script>
