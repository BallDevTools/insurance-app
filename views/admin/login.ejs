<div class="login-wrap">
  <div class="login-card">
    <div class="login-logo">🛡️</div>
    <h1 class="login-title">Admin Login</h1>
    <p class="login-sub">ระบบประกันรถยนต์ออนไลน์</p>

    <% if (error) { %>
      <div class="login-error">⚠️ <%= error %></div>
    <% } %>

    <form action="/admin/login" method="POST" autocomplete="off">
      <div class="login-field">
        <label>Username</label>
        <input type="text" name="username" placeholder="กรอก username" autofocus required>
      </div>
      <div class="login-field">
        <label>Password</label>
        <input type="password" name="password" placeholder="กรอก password" required>
      </div>
      <button type="submit" class="login-btn">เข้าสู่ระบบ →</button>
    </form>

    <div class="login-hint">Default: admin / admin1234</div>
  </div>
</div>
