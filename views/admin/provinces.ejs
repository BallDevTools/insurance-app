<% if (msg) { %><div class="adm-alert adm-alert-success"><%= msg %></div><% } %>

<div class="adm-card" style="max-width:700px">
  <div class="adm-card-title">📍 เพิ่มจังหวัดใหม่</div>
  <form action="/admin/provinces/add" method="POST" class="adm-inline-form">
    <input type="text" name="name" placeholder="ชื่อจังหวัด" required>
    <input type="number" name="risk_factor" placeholder="Risk Factor (เช่น 1.15)" step="0.01" min="1" max="2" required>
    <button type="submit" class="adm-btn adm-btn-primary">+ เพิ่ม</button>
  </form>
</div>

<div class="adm-card adm-card-full">
  <div class="adm-card-title">รายการจังหวัด (<%= provinces.length %>)</div>
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead><tr>
        <th>#</th><th>จังหวัด</th><th>Risk Factor</th><th>ความเสี่ยง</th><th>แก้ไข</th><th>ลบ</th>
      </tr></thead>
      <tbody>
        <% provinces.forEach((p,i)=>{ %>
          <tr>
            <td><%= i+1 %></td>
            <td><%= p.name %></td>
            <td>
              <form action="/admin/provinces/<%= p.id %>/edit" method="POST" class="adm-inline-edit">
                <input type="hidden" name="name" value="<%= p.name %>">
                <input type="number" name="risk_factor" value="<%= p.risk_factor %>" step="0.01" min="1" max="2" style="width:80px">
                <button type="submit" class="adm-link-sm">บันทึก</button>
              </form>
            </td>
            <td>
              <div class="adm-risk-bar">
                <div class="adm-risk-fill" style="width:<%= Math.min(100, Math.round((parseFloat(p.risk_factor)-1)/0.3*100)) %>%;
                  background:<%= parseFloat(p.risk_factor)>=1.2?'#dc2626':parseFloat(p.risk_factor)>=1.1?'#d97706':'#059669' %>">
                </div>
              </div>
              <span class="adm-sub"><%= parseFloat(p.risk_factor)>=1.2?'สูง':parseFloat(p.risk_factor)>=1.1?'กลาง':'ต่ำ' %></span>
            </td>
            <td>
              <form action="/admin/provinces/<%= p.id %>/edit" method="POST" class="adm-inline-edit">
                <input type="hidden" name="risk_factor" value="<%= p.risk_factor %>">
                <input type="text" name="name" value="<%= p.name %>" style="width:120px">
                <button type="submit" class="adm-link-sm">เปลี่ยนชื่อ</button>
              </form>
            </td>
            <td>
              <form action="/admin/provinces/<%= p.id %>/delete" method="POST"
                    onsubmit="return confirm('ลบ <%= p.name %>?')">
                <button type="submit" class="adm-btn-del">ลบ</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
