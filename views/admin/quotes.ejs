<!-- FILTER BAR -->
<div class="adm-card adm-filter-card">
  <form action="/admin/quotes" method="GET" class="adm-filter-form">
    <input type="text" name="q" value="<%= filters.q %>" placeholder="🔍 ค้นหา เลขที่ / ทะเบียน / รถ">
    <select name="type">
      <option value="">ประกันทุกชั้น</option>
      <option value="class1"    <%= filters.type==='class1'?'selected':'' %>>ชั้น 1</option>
      <option value="class2plus"<%= filters.type==='class2plus'?'selected':'' %>>ชั้น 2+</option>
      <option value="class3plus"<%= filters.type==='class3plus'?'selected':'' %>>ชั้น 3+</option>
    </select>
    <select name="status">
      <option value="">ทุกสถานะ</option>
      <option value="pending"   <%= filters.status==='pending'?'selected':'' %>>รอติดต่อ</option>
      <option value="contacted" <%= filters.status==='contacted'?'selected':'' %>>ติดต่อแล้ว</option>
      <option value="completed" <%= filters.status==='completed'?'selected':'' %>>สำเร็จ</option>
      <option value="cancelled" <%= filters.status==='cancelled'?'selected':'' %>>ยกเลิก</option>
    </select>
    <input type="date" name="from" value="<%= filters.from %>" title="วันเริ่มต้น">
    <input type="date" name="to"   value="<%= filters.to %>"   title="วันสิ้นสุด">
    <button type="submit" class="adm-btn adm-btn-primary">ค้นหา</button>
    <a href="/admin/quotes" class="adm-btn adm-btn-ghost">ล้าง</a>
  </form>
  <a href="/admin/quotes/export?q=<%= filters.q %>&type=<%= filters.type %>&status=<%= filters.status %>&from=<%= filters.from %>&to=<%= filters.to %>"
     class="adm-btn adm-btn-success adm-export-btn">📥 Export CSV</a>
</div>

<!-- TABLE -->
<div class="adm-card adm-card-full">
  <div class="adm-card-header">
    <div class="adm-card-title">รายการทั้งหมด <span class="adm-badge"><%= total %></span></div>
  </div>
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead><tr>
        <th>เลขที่</th><th>รถ</th><th>ทะเบียน</th><th>จังหวัด</th>
        <th>ประกัน</th><th>เบี้ย</th><th>ลูกค้า</th><th>สถานะ</th><th>วันที่</th><th></th>
      </tr></thead>
      <tbody>
        <% if (!quotes.length) { %><tr><td colspan="10" class="adm-empty-cell">ไม่พบข้อมูล</td></tr><% } %>
        <% quotes.forEach(q=>{ %>
          <tr>
            <td><a href="/admin/quotes/<%= q.id %>" class="adm-qnum"><%= q.quote_number %></a></td>
            <td><div><%= q.car_brand %> <%= q.car_model %></div><div class="adm-sub">ปี <%= q.car_year %></div></td>
            <td><span class="adm-plate"><%= q.license_plate %></span></td>
            <td><%= q.province %></td>
            <td><span class="adm-type-pill adm-type-<%= q.insurance_type %>"><%= TYPE_MAP[q.insurance_type] %></span></td>
            <td class="adm-money">฿<%= formatNumber(q.premium_amount) %></td>
            <td>
              <% if (q.full_name) { %>
                <div class="adm-name"><%= q.full_name %></div>
                <a href="tel:<%= q.phone %>" class="adm-phone"><%= q.phone %></a>
              <% } else { %><span class="adm-sub">-</span><% } %>
            </td>
            <td><span class="adm-status adm-status-<%= q.status %>"><%= STATUS_MAP[q.status] %></span></td>
            <td class="adm-dt"><%= new Date(q.created_at).toLocaleDateString('th-TH',{day:'numeric',month:'short',year:'2-digit'}) %></td>
            <td><a href="/admin/quotes/<%= q.id %>" class="adm-link-sm">ดู →</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <div class="adm-pagination">
      <% for (let i=1; i<=totalPages; i++) { %>
        <a href="?page=<%= i %>&q=<%= filters.q %>&type=<%= filters.type %>&status=<%= filters.status %>&from=<%= filters.from %>&to=<%= filters.to %>"
           class="adm-page-btn <%= page===i?'active':'' %>"><%= i %></a>
      <% } %>
    </div>
  <% } %>
</div>
