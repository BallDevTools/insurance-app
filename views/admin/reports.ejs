<%
const pct = (a, b) => b > 0 ? Math.round(a / b * 100) : 0
const f = funnel
const lineRate  = pct(f.line_clicks,  f.total_leads)
const fbRate    = pct(f.fb_clicks,    f.total_leads)
const clickRate = pct(f.total_clicks, f.total_leads)
const convRate  = pct(f.converted,    f.total_leads)
%>

<% if (admin.role === 'superadmin') { %>
<!-- VIEW TABS -->
<div class="rpt-tabs">
  <a href="/admin/reports?view=direct"
     class="rpt-tab <%= view === 'direct' ? 'rpt-tab-active' : '' %>">
    <i data-lucide="user" style="width:14px;height:14px;vertical-align:middle;margin-right:5px"></i>
    Direct / Owner
  </a>
  <a href="/admin/reports?view=affiliate"
     class="rpt-tab <%= view === 'affiliate' ? 'rpt-tab-active' : '' %>">
    <i data-lucide="users" style="width:14px;height:14px;vertical-align:middle;margin-right:5px"></i>
    Affiliate
  </a>
</div>
<style>
.rpt-tabs{display:flex;gap:4px;margin-bottom:1rem;background:#f1f5f9;padding:4px;border-radius:10px;width:fit-content}
.rpt-tab{padding:7px 20px;border-radius:8px;font-size:13px;font-weight:600;color:#64748b;text-decoration:none;transition:all .15s;display:flex;align-items:center}
.rpt-tab:hover{background:#e2e8f0;color:#334155}
.rpt-tab-active{background:#fff;color:#1e293b;box-shadow:0 1px 4px rgba(0,0,0,.1)}
</style>
<% } %>

<!-- FUNNEL STATS -->
<div class="adm-stats">
  <div class="adm-stat adm-stat-blue">
    <div class="adm-stat-icon"><i data-lucide="users"></i></div>
    <div>
      <div class="adm-stat-val"><%= f.total_leads||0 %></div>
      <div class="adm-stat-lbl">Leads ทั้งหมด</div>
    </div>
  </div>
  <div class="adm-stat adm-stat-green">
    <div class="adm-stat-icon"><i data-lucide="message-circle"></i></div>
    <div>
      <div class="adm-stat-val"><%= f.line_clicks||0 %></div>
      <div class="adm-stat-lbl">คลิก LINE</div>
      <div class="adm-stat-sub"><%= lineRate %>% ของ leads</div>
    </div>
  </div>
  <div class="adm-stat adm-stat-purple">
    <div class="adm-stat-icon"><i data-lucide="thumbs-up"></i></div>
    <div>
      <div class="adm-stat-val"><%= f.fb_clicks||0 %></div>
      <div class="adm-stat-lbl">คลิก Facebook</div>
      <div class="adm-stat-sub"><%= fbRate %>% ของ leads</div>
    </div>
  </div>
  <div class="adm-stat adm-stat-orange">
    <div class="adm-stat-icon"><i data-lucide="trophy"></i></div>
    <div>
      <div class="adm-stat-val"><%= f.converted||0 %></div>
      <div class="adm-stat-lbl">ปิดงานสำเร็จ</div>
      <div class="adm-stat-sub"><%= convRate %>% conversion</div>
    </div>
  </div>
</div>

<!-- MONTHLY LINE CHART -->
<div class="adm-card adm-card-full">
  <div class="adm-card-header">
    <div class="adm-card-title">Leads รายเดือน (12 เดือนล่าสุด)</div>
    <div style="display:flex;gap:1.2rem;font-size:.78rem;color:#94a3b8;align-items:center">
      <span style="display:flex;align-items:center;gap:6px"><span style="width:24px;height:3px;background:#3b82f6;border-radius:2px;display:inline-block"></span>Leads</span>
      <span style="display:flex;align-items:center;gap:6px"><span style="width:24px;height:3px;background:#10b981;border-radius:2px;display:inline-block"></span>คลิก</span>
    </div>
  </div>
  <div style="height:220px;padding:4px 0 8px">
    <canvas id="chartMonthly"></canvas>
  </div>
</div>

<!-- ROW: SOURCE + TYPE DONUTS + 7-DAY BARS -->
<div class="rpt-grid-3">

  <div class="adm-card">
    <div class="adm-card-title">📡 แหล่ง Traffic</div>
    <% if (!bySource.length) { %><div class="adm-empty">ยังไม่มีข้อมูล</div><% } else { %>
    <div style="height:200px;margin:8px 0"><canvas id="chartSource"></canvas></div>
    <div class="rpt-legend" id="legendSource"></div>
    <% } %>
  </div>

  <div class="adm-card">
    <div class="adm-card-title">🛡️ ประเภทประกัน</div>
    <% if (!byType.length) { %><div class="adm-empty">ยังไม่มีข้อมูล</div><% } else { %>
    <div style="height:200px;margin:8px 0"><canvas id="chartType"></canvas></div>
    <div class="rpt-legend" id="legendType"></div>
    <% } %>
  </div>

  <div class="adm-card">
    <div class="adm-card-title">📅 7 วันล่าสุด</div>
    <% if (!daily.length) { %><div class="adm-empty">ยังไม่มีข้อมูล</div><% } else { %>
    <div style="height:200px;margin:8px 0"><canvas id="chartDaily"></canvas></div>
    <% } %>
  </div>

</div>

<!-- TOP BRANDS -->
<div class="adm-card adm-card-full">
  <div class="adm-card-header">
    <div class="adm-card-title">🚗 ยี่ห้อรถยอดนิยม (Top 8)</div>
  </div>
  <% if (!topBrands.length) { %><div class="adm-empty">ยังไม่มีข้อมูล</div><% } else { %>
  <div style="height:<%= Math.max(160, topBrands.length * 36) %>px;padding:8px 0">
    <canvas id="chartBrands"></canvas>
  </div>
  <% } %>
</div>

<!-- AFFILIATE BREAKDOWN (affiliate view only) -->
<% if (view === 'affiliate' && affBreakdown && affBreakdown.length) { %>
<div class="adm-card adm-card-full">
  <div class="adm-card-header">
    <div class="adm-card-title">🤝 สรุปรายละเอียดต่อ Affiliate</div>
    <a href="/admin/affiliates" class="adm-btn adm-btn-ghost" style="font-size:.8rem">จัดการ Affiliates →</a>
  </div>
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead><tr>
        <th>Affiliate</th>
        <th>Rate</th>
        <th style="text-align:right">Leads</th>
        <th style="text-align:right">Converted</th>
        <th style="text-align:right">Click Rate</th>
        <th style="text-align:right">Conv Rate</th>
        <th style="text-align:right">ค้างจ่าย</th>
        <th style="text-align:right">จ่ายแล้ว</th>
      </tr></thead>
      <tbody>
        <% affBreakdown.forEach(a => { %>
        <% const aClickRate = pct(a.clicks, a.total_leads) %>
        <% const aConvRate  = pct(a.converted, a.total_leads) %>
        <tr>
          <td>
            <div style="font-weight:600;color:#1e293b"><%= a.name %></div>
            <div style="font-size:11px;color:#94a3b8;font-family:monospace">?aff=<%= a.slug %></div>
          </td>
          <td><span style="font-size:12px;background:#f1f5f9;padding:2px 8px;border-radius:6px;font-weight:600"><%= parseFloat(a.commission_rate).toFixed(1) %>%</span></td>
          <td style="text-align:right;font-weight:600"><%= a.total_leads || 0 %></td>
          <td style="text-align:right"><%= a.converted || 0 %></td>
          <td style="text-align:right">
            <span style="color:<%= aClickRate >= 20 ? '#059669' : aClickRate >= 10 ? '#f59e0b' : '#94a3b8' %>"><%= aClickRate %>%</span>
          </td>
          <td style="text-align:right">
            <span style="color:<%= aConvRate >= 10 ? '#059669' : aConvRate >= 5 ? '#f59e0b' : '#94a3b8' %>"><%= aConvRate %>%</span>
          </td>
          <td style="text-align:right;color:#f59e0b;font-weight:600">
            <% if (parseFloat(a.pending_commission||0) > 0) { %>฿<%= formatNumber(a.pending_commission) %><% } else { %><span style="color:#cbd5e1">-</span><% } %>
          </td>
          <td style="text-align:right;color:#059669;font-weight:600">
            <% if (parseFloat(a.paid_commission||0) > 0) { %>฿<%= formatNumber(a.paid_commission) %><% } else { %><span style="color:#cbd5e1">-</span><% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr style="background:#f8fafc;font-weight:700">
          <td colspan="2" style="color:#64748b;font-size:12px">รวมทั้งหมด</td>
          <td style="text-align:right"><%= affBreakdown.reduce((s,a)=>s+(parseInt(a.total_leads)||0),0) %></td>
          <td style="text-align:right"><%= affBreakdown.reduce((s,a)=>s+(parseInt(a.converted)||0),0) %></td>
          <td colspan="2"></td>
          <td style="text-align:right;color:#f59e0b">
            <% const totalPending = affBreakdown.reduce((s,a)=>s+(parseFloat(a.pending_commission)||0),0) %>
            <% if (totalPending > 0) { %>฿<%= formatNumber(totalPending.toFixed(0)) %><% } else { %>-<% } %>
          </td>
          <td style="text-align:right;color:#059669">
            <% const totalPaid = affBreakdown.reduce((s,a)=>s+(parseFloat(a.paid_commission)||0),0) %>
            <% if (totalPaid > 0) { %>฿<%= formatNumber(totalPaid.toFixed(0)) %><% } else { %>-<% } %>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
<% } %>

<!-- RECENT LEADS -->
<div class="adm-card adm-card-full">
  <div class="adm-card-header">
    <div class="adm-card-title">🕐 Leads ล่าสุด 10 รายการ</div>
    <a href="/admin/leads" class="adm-btn adm-btn-ghost" style="font-size:.8rem">ดูทั้งหมด →</a>
  </div>
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead><tr>
        <th>รถ / ประกัน</th><th>ราคาดีสุด</th><th>ลูกค้า</th><th>CTA</th><th>แหล่ง</th><th>สถานะ</th><th>วันที่</th>
      </tr></thead>
      <tbody>
        <% if (!recentLeads.length) { %>
          <tr><td colspan="7" class="adm-empty-cell">ยังไม่มีข้อมูล</td></tr>
        <% } %>
        <% recentLeads.forEach(l=>{ %>
          <tr>
            <td>
              <div><strong><%= l.brand %> <%= l.model %></strong> ปี <%= l.year %></div>
              <div><span class="adm-type-pill adm-type-<%= l.insurance_type %>"><%= TYPE_MAP[l.insurance_type]||l.insurance_type %></span></div>
            </td>
            <td class="adm-money"><% if (l.best_price) { %>฿<%= formatNumber(l.best_price) %><% } else { %>-<% } %></td>
            <td>
              <% if (l.name) { %><div><%= l.name %></div><% } else { %><span class="adm-sub">ไม่ระบุ</span><% } %>
              <% if (l.phone) { %><div class="adm-sub"><%= l.phone %></div><% } %>
            </td>
            <td>
              <% if (l.clicked_line) { %><span class="adm-click-badge adm-click-line">LINE ✓</span> <% } %>
              <% if (l.clicked_facebook) { %><span class="adm-click-badge adm-click-fb">FB ✓</span><% } %>
              <% if (!l.clicked_line && !l.clicked_facebook) { %><span class="adm-sub">-</span><% } %>
            </td>
            <td class="adm-sub"><%= SOURCE_MAP[l.source]||l.source||'-' %></td>
            <td><span class="adm-status adm-status-<%= l.status %>"><%= LEAD_STATUS_MAP[l.status]||l.status %></span></td>
            <td class="adm-dt"><%= new Date(l.created_at).toLocaleDateString('th-TH',{day:'numeric',month:'short',year:'2-digit'}) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<style>
.rpt-grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:1rem}
@media(max-width:900px){.rpt-grid-3{grid-template-columns:1fr}}
.rpt-legend{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:4px}
.rpt-legend-item{display:flex;align-items:center;gap:5px;font-size:11px;color:#64748b}
.rpt-legend-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
;(function(){
  Chart.defaults.font.family = "'Sarabun','Inter',sans-serif"
  Chart.defaults.font.size = 11.5
  Chart.defaults.color = '#94a3b8'

  const PALETTE = ['#3b82f6','#10b981','#8b5cf6','#f59e0b','#ec4899','#14b8a6','#f97316','#6366f1']

  const monthly  = <%- JSON.stringify(monthly) %>
  const daily    = <%- JSON.stringify(daily) %>
  const bySource = <%- JSON.stringify(bySource) %>
  const byType   = <%- JSON.stringify(byType) %>
  const topBrands= <%- JSON.stringify(topBrands) %>
  const SOURCE_MAP = <%- JSON.stringify(SOURCE_MAP) %>
  const TYPE_MAP   = <%- JSON.stringify(TYPE_MAP) %>

  // ── Monthly Line Chart ──────────────────────────────────────
  ;(function(){
    const el = document.getElementById('chartMonthly')
    if (!el || !monthly.length) return
    const ctx = el.getContext('2d')
    const gradBlue = ctx.createLinearGradient(0,0,0,220)
    gradBlue.addColorStop(0,'rgba(59,130,246,.18)')
    gradBlue.addColorStop(1,'rgba(59,130,246,0)')
    const gradGreen = ctx.createLinearGradient(0,0,0,220)
    gradGreen.addColorStop(0,'rgba(16,185,129,.15)')
    gradGreen.addColorStop(1,'rgba(16,185,129,0)')

    new Chart(ctx, {
      type: 'line',
      data: {
        labels: monthly.map(m => m.month_label),
        datasets: [
          {
            label: 'Leads',
            data: monthly.map(m => m.leads),
            borderColor: '#3b82f6',
            backgroundColor: gradBlue,
            borderWidth: 2.5,
            pointRadius: 4,
            pointHoverRadius: 6,
            pointBackgroundColor: '#fff',
            pointBorderColor: '#3b82f6',
            pointBorderWidth: 2,
            fill: true,
            tension: 0.4
          },
          {
            label: 'คลิก',
            data: monthly.map(m => m.clicks),
            borderColor: '#10b981',
            backgroundColor: gradGreen,
            borderWidth: 2,
            pointRadius: 3,
            pointHoverRadius: 5,
            pointBackgroundColor: '#fff',
            pointBorderColor: '#10b981',
            pointBorderWidth: 2,
            fill: true,
            tension: 0.4
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#1e293b',
            titleColor: '#f1f5f9',
            bodyColor: '#cbd5e1',
            borderColor: '#334155',
            borderWidth: 1,
            padding: 10,
            cornerRadius: 8
          }
        },
        scales: {
          x: {
            grid: { display: false },
            border: { display: false },
            ticks: { maxRotation: 0 }
          },
          y: {
            grid: { color: '#f1f5f9', drawBorder: false },
            border: { display: false, dash: [4,4] },
            ticks: { precision: 0, stepSize: 1 },
            beginAtZero: true
          }
        }
      }
    })
  })()

  // ── Donut helper ─────────────────────────────────────────────
  function makeDoughnut(canvasId, legendId, labels, data, colors) {
    const el = document.getElementById(canvasId)
    if (!el) return
    new Chart(el, {
      type: 'doughnut',
      data: {
        labels,
        datasets: [{
          data,
          backgroundColor: colors,
          borderWidth: 2,
          borderColor: '#fff',
          hoverBorderWidth: 0,
          hoverOffset: 6
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '68%',
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#1e293b',
            titleColor: '#f1f5f9',
            bodyColor: '#cbd5e1',
            borderColor: '#334155',
            borderWidth: 1,
            cornerRadius: 8,
            padding: 10,
            callbacks: {
              label: ctx => ` ${ctx.label}: ${ctx.parsed} leads (${Math.round(ctx.parsed/data.reduce((a,b)=>a+b,0)*100)}%)`
            }
          }
        }
      }
    })
    if (legendId) {
      const wrap = document.getElementById(legendId)
      if (wrap) wrap.innerHTML = labels.map((l,i) =>
        `<div class="rpt-legend-item"><span class="rpt-legend-dot" style="background:${colors[i]}"></span>${l} <strong style="color:#334155">${data[i]}</strong></div>`
      ).join('')
    }
  }

  // ── Source Donut ─────────────────────────────────────────────
  makeDoughnut(
    'chartSource', 'legendSource',
    bySource.map(s => SOURCE_MAP[s.source] || s.source || 'อื่นๆ'),
    bySource.map(s => s.cnt),
    PALETTE
  )

  // ── Type Donut ───────────────────────────────────────────────
  const TYPE_COLOR = { class1:'#3b82f6', class2plus:'#8b5cf6', class3plus:'#10b981', compulsory:'#f59e0b' }
  makeDoughnut(
    'chartType', 'legendType',
    byType.map(t => TYPE_MAP[t.insurance_type] || t.insurance_type),
    byType.map(t => t.cnt),
    byType.map(t => TYPE_COLOR[t.insurance_type] || '#94a3b8')
  )

  // ── 7-Day Bar ────────────────────────────────────────────────
  ;(function(){
    const el = document.getElementById('chartDaily')
    if (!el || !daily.length) return
    new Chart(el, {
      type: 'bar',
      data: {
        labels: daily.map(d => d.day_label),
        datasets: [
          {
            label: 'Leads',
            data: daily.map(d => d.leads),
            backgroundColor: '#3b82f6',
            borderRadius: 6,
            borderSkipped: false,
            maxBarThickness: 32
          },
          {
            label: 'คลิก',
            data: daily.map(d => d.clicks),
            backgroundColor: '#10b981',
            borderRadius: 6,
            borderSkipped: false,
            maxBarThickness: 32
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: {
            position: 'bottom',
            labels: { usePointStyle: true, pointStyle: 'circle', padding: 16 }
          },
          tooltip: {
            backgroundColor: '#1e293b',
            titleColor: '#f1f5f9',
            bodyColor: '#cbd5e1',
            cornerRadius: 8,
            padding: 10
          }
        },
        scales: {
          x: { grid: { display: false }, border: { display: false } },
          y: {
            grid: { color: '#f1f5f9' },
            border: { display: false },
            ticks: { precision: 0 },
            beginAtZero: true
          }
        }
      }
    })
  })()

  // ── Top Brands Horizontal Bar ────────────────────────────────
  ;(function(){
    const el = document.getElementById('chartBrands')
    if (!el || !topBrands.length) return
    const labels = topBrands.map((b,i) => `#${i+1} ${b.brand||'ไม่ระบุ'}`)
    new Chart(el, {
      type: 'bar',
      data: {
        labels,
        datasets: [{
          label: 'Leads',
          data: topBrands.map(b => b.cnt),
          backgroundColor: topBrands.map((_,i) => PALETTE[i % PALETTE.length] + 'cc'),
          borderColor:      topBrands.map((_,i) => PALETTE[i % PALETTE.length]),
          borderWidth: 1.5,
          borderRadius: 5,
          borderSkipped: false,
          maxBarThickness: 22
        }]
      },
      options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#1e293b',
            titleColor: '#f1f5f9',
            bodyColor: '#cbd5e1',
            cornerRadius: 8,
            padding: 10,
            callbacks: { label: ctx => ` ${ctx.parsed.x} leads` }
          }
        },
        scales: {
          x: {
            grid: { color: '#f1f5f9' },
            border: { display: false },
            ticks: { precision: 0 }
          },
          y: {
            grid: { display: false },
            border: { display: false },
            ticks: { font: { size: 12, weight: '600' }, color: '#475569' }
          }
        }
      }
    })
  })()

})()
</script>
