<% const isAffiliate = admin.role === 'affiliate' %>
<% if (saved) { %><div class="adm-alert adm-alert-success">✅ บันทึกการตั้งค่าเรียบร้อย</div><% } %>

<% if (isAffiliate && locals.affSlug) { %>
<style>
.aff-link-card{background:linear-gradient(135deg,#6d28d9 0%,#4c1d95 100%);border-radius:14px;padding:24px 28px;margin-bottom:20px;color:#fff;box-shadow:0 4px 24px rgba(109,40,217,.35)}
.aff-link-card__label{font-size:11px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;opacity:.65;margin-bottom:14px}
.aff-link-card__row{display:flex;align-items:center;gap:10px;margin-bottom:18px}
.aff-link-card__url{flex:1;background:rgba(255,255,255,.12);backdrop-filter:blur(4px);border:1px solid rgba(255,255,255,.2);border-radius:8px;padding:10px 14px;font-size:13px;font-family:monospace;color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.aff-link-card__copy{background:#fff;color:#6d28d9;border:none;border-radius:8px;padding:10px 18px;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap;transition:opacity .15s}
.aff-link-card__copy:hover{opacity:.88}
.aff-link-card__divider{border:none;border-top:1px solid rgba(255,255,255,.15);margin:0 0 18px}
.aff-link-card__slug-label{font-size:11px;font-weight:600;letter-spacing:.5px;text-transform:uppercase;opacity:.6;margin-bottom:10px}
.aff-link-card__slug-row{display:flex;align-items:center;gap:0;flex-wrap:wrap;gap:8px}
.aff-link-card__slug-prefix{font-size:12px;opacity:.6;white-space:nowrap;font-family:monospace}
.aff-link-card__slug-input{background:rgba(255,255,255,.15);border:1.5px solid rgba(255,255,255,.3);color:#fff;border-radius:8px;padding:8px 12px;font-size:13px;font-family:monospace;width:150px;outline:none;transition:border-color .15s}
.aff-link-card__slug-input:focus{border-color:rgba(255,255,255,.7);background:rgba(255,255,255,.2)}
.aff-link-card__slug-input::placeholder{opacity:.4}
.aff-link-card__slug-btn{background:rgba(255,255,255,.2);border:1.5px solid rgba(255,255,255,.35);color:#fff;border-radius:8px;padding:8px 16px;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;transition:background .15s}
.aff-link-card__slug-btn:hover{background:rgba(255,255,255,.3)}
.aff-link-card__slug-hint{font-size:11px;opacity:.45}
.aff-link-card__error{background:rgba(239,68,68,.25);border:1px solid rgba(239,68,68,.4);border-radius:7px;padding:7px 12px;font-size:12px;margin-bottom:12px}
</style>

<div class="aff-link-card">
  <div class="aff-link-card__label">🔗 ลิงก์ Affiliate ของคุณ</div>

  <div class="aff-link-card__row">
    <div class="aff-link-card__url" id="affLinkSettings" title="<%= appUrl %>/?aff=<%= affSlug %>"><%= appUrl %>/?aff=<%= affSlug %></div>
    <button type="button" class="aff-link-card__copy" id="copyBtnSettings" onclick="copyAffSettings()">คัดลอก</button>
  </div>

  <hr class="aff-link-card__divider">

  <div class="aff-link-card__slug-label">เปลี่ยน Slug</div>
  <% if (locals.slugError === 'taken') { %>
    <div class="aff-link-card__error">❌ Slug นี้ถูกใช้ไปแล้ว กรุณาเลือกใหม่</div>
  <% } else if (locals.slugError === 'invalid') { %>
    <div class="aff-link-card__error">❌ ใช้ได้เฉพาะ a–z, 0–9, เครื่องหมาย - และ _ เท่านั้น</div>
  <% } %>
  <form action="/admin/settings/slug" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="aff-link-card__slug-row">
      <span class="aff-link-card__slug-prefix"><%= appUrl %>/?aff=</span>
      <input class="aff-link-card__slug-input" type="text" name="new_slug"
             value="<%= affSlug %>" placeholder="your-slug"
             pattern="[a-zA-Z0-9_-]+" required maxlength="50">
      <button type="submit" class="aff-link-card__slug-btn">บันทึก</button>
      <span class="aff-link-card__slug-hint">a–z · 0–9 · - · _</span>
    </div>
  </form>
</div>

<script>
function copyAffSettings() {
  const url = '<%= appUrl %>/?aff=<%= affSlug %>'
  navigator.clipboard.writeText(url).then(() => {
    const btn = document.getElementById('copyBtnSettings')
    const orig = btn.textContent
    btn.textContent = '✓ คัดลอกแล้ว'
    btn.style.background = '#059669'
    btn.style.color = '#fff'
    setTimeout(() => { btn.textContent = orig; btn.style.background = ''; btn.style.color = '' }, 2000)
  })
}
</script>
<% } %>

<form action="/admin/settings" method="POST">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="adm-settings-grid">

  <!-- CTA URLs + Phone — ทั้ง superadmin และ affiliate -->
  <div class="adm-card">
    <div class="adm-card-title">📲 ช่องทาง CTA (ปุ่มในหน้า Result)</div>
    <% if (isAffiliate) { %>
    <div class="adm-settings-note">ค่าที่ตั้งไว้จะแสดงให้ลูกค้าของคุณโดยเฉพาะ ถ้าว่างไว้จะใช้ค่ากลางของระบบ</div>
    <% } else { %>
    <div class="adm-settings-note">URL ที่ลูกค้าจะถูก redirect ไปเมื่อกดปุ่ม LINE หรือ Facebook</div>
    <% } %>
    <div class="adm-settings-row">
      <label>LINE OA URL</label>
      <input type="url" name="line_oa_url" value="<%= settings.line_oa_url||'' %>" placeholder="https://line.me/R/ti/p/@...">
    </div>
    <div class="adm-settings-row">
      <label>Facebook URL</label>
      <input type="url" name="facebook_url" value="<%= settings.facebook_url||'' %>" placeholder="https://m.me/...">
    </div>
    <div class="adm-settings-row">
      <label>เบอร์โทรสายด่วน</label>
      <input type="text" name="site_phone" value="<%= settings.site_phone||'' %>" placeholder="02-xxx-xxxx">
    </div>
  </div>

  <!-- GTM / GA4 Code — ทั้ง superadmin และ affiliate -->
  <div class="adm-card">
    <div class="adm-card-title">📊 Google Tag Manager / GA4</div>
    <div class="adm-settings-note">วาง GTM snippet หรือ GA4 gtag ตรงนี้ได้เลย ใส่หรือไม่ใส่ก็ได้</div>
    <div class="adm-settings-row" style="flex-direction:column;align-items:flex-start;gap:6px">
      <label style="margin-bottom:2px">&lt;head&gt; Code <span style="font-size:11px;color:#94a3b8">(GTM head snippet / gtag.js)</span></label>
      <textarea name="gtm_head_code" rows="5" placeholder="<!-- Google Tag Manager -->&#10;<script>...</script>" style="width:100%;font-family:monospace;font-size:12px;border:1px solid #e2e8f0;border-radius:6px;padding:8px;resize:vertical"><%= settings.gtm_head_code||'' %></textarea>
    </div>
    <div class="adm-settings-row" style="flex-direction:column;align-items:flex-start;gap:6px;margin-top:8px">
      <label style="margin-bottom:2px">&lt;body&gt; Code <span style="font-size:11px;color:#94a3b8">(GTM noscript / optional)</span></label>
      <textarea name="gtm_body_code" rows="3" placeholder="<!-- Google Tag Manager (noscript) -->&#10;<noscript>...</noscript>" style="width:100%;font-family:monospace;font-size:12px;border:1px solid #e2e8f0;border-radius:6px;padding:8px;resize:vertical"><%= settings.gtm_body_code||'' %></textarea>
    </div>
  </div>

  <% if (!isAffiliate) { %>

  <!-- Site Email — superadmin only -->
  <div class="adm-card">
    <div class="adm-card-title">🏢 ข้อมูลเพิ่มเติม</div>
    <div class="adm-settings-row">
      <label>อีเมลติดต่อ</label>
      <input type="email" name="site_email" value="<%= settings.site_email||'' %>" placeholder="info@...">
    </div>
    <div class="adm-settings-row">
      <label>LINE Admin User ID</label>
      <input type="text" name="line_admin_user_id" value="<%= settings.line_admin_user_id||'' %>" placeholder="Uxxxxxxxxxx...">
      <span class="adm-settings-hint" style="font-size:11px">รับแจ้งเตือน lead ใหม่</span>
    </div>
  </div>

  <!-- Commission Settings — superadmin only -->
  <div class="adm-card">
    <div class="adm-card-title">🤝 Commission Mode (Affiliate)</div>
    <div class="adm-settings-note">เลือกว่า commission คิดจากอะไร — ใช้กับ affiliate ทุกคน</div>
    <div class="adm-settings-row">
      <label>Mode</label>
      <div style="display:flex;flex-direction:column;gap:8px">
        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-weight:400">
          <input type="radio" name="commission_base" value="premium" id="cb_premium"
            <%= (settings.commission_base||'premium') === 'premium' ? 'checked' : '' %>>
          คิดจากเบี้ยเต็ม (Premium)
        </label>
        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-weight:400">
          <input type="radio" name="commission_base" value="broker_fee" id="cb_broker"
            <%= settings.commission_base === 'broker_fee' ? 'checked' : '' %>>
          คิดจาก Broker Fee
        </label>
      </div>
    </div>
    <div class="adm-settings-row" id="brokerFeeRow" style="<%= settings.commission_base === 'broker_fee' ? '' : 'display:none' %>">
      <label>Broker Fee Rate (%)</label>
      <input type="number" name="broker_fee_rate" value="<%= settings.broker_fee_rate || '15' %>" min="0" max="100" step="0.1" style="max-width:120px">
      <span class="adm-settings-hint">% ของเบี้ยประกัน</span>
    </div>
    <div class="adm-settings-note" style="color:#6b7280;font-size:0.78rem">
      Premium: commission = เบี้ย × rate% affiliate<br>
      Broker Fee: commission = (เบี้ย × broker_fee%) × rate% affiliate
    </div>
  </div>

  <!-- Theme Colors — superadmin only -->
  <div class="adm-card">
    <div class="adm-card-title">🎨 ธีม / สีระบบ</div>
    <div class="adm-settings-note">ปรับสีหลังบ้านได้ตามต้องการ</div>
    <div class="adm-settings-row">
      <label>สี Sidebar</label>
      <input type="color" name="theme_sidebar_bg" value="<%= settings.theme_sidebar_bg || '#0f172a' %>" class="adm-color-input">
      <span class="adm-settings-hint adm-color-preview" id="prev_sidebar"><%= settings.theme_sidebar_bg || '#0f172a' %></span>
    </div>
    <div class="adm-settings-row">
      <label>สี Accent (ปุ่ม/Active)</label>
      <input type="color" name="theme_accent" value="<%= settings.theme_accent || '#1a56db' %>" class="adm-color-input">
      <span class="adm-settings-hint adm-color-preview" id="prev_accent"><%= settings.theme_accent || '#1a56db' %></span>
    </div>
    <div class="adm-settings-row">
      <label>สี พื้นหลัง Content</label>
      <input type="color" name="theme_content_bg" value="<%= settings.theme_content_bg || '#f1f5f9' %>" class="adm-color-input">
      <span class="adm-settings-hint adm-color-preview" id="prev_content"><%= settings.theme_content_bg || '#f1f5f9' %></span>
    </div>
    <div class="adm-settings-row" style="border-top:none;padding-top:0">
      <label></label>
      <div class="adm-theme-preview-bar" id="themePreviewBar">
        <span class="adm-theme-swatch" id="swatch_sidebar" style="background:<%= settings.theme_sidebar_bg||'#0f172a' %>"></span>
        <span class="adm-theme-swatch" id="swatch_accent" style="background:<%= settings.theme_accent||'#1a56db' %>"></span>
        <span class="adm-theme-swatch" id="swatch_content" style="background:<%= settings.theme_content_bg||'#f1f5f9' %>;border:1px solid #e2e8f0"></span>
        <span class="adm-theme-swatch-lbl">Preview</span>
      </div>
    </div>
  </div>

  <% } %>

</div>

<div class="adm-settings-footer">
  <button type="submit" class="adm-btn adm-btn-primary adm-btn-lg">บันทึกการตั้งค่า</button>
</div>
</form>
<script>
;(function() {
  const brokerRow = document.getElementById('brokerFeeRow')
  if (brokerRow) {
    document.querySelectorAll('input[name="commission_base"]').forEach(r => {
      r.addEventListener('change', () => {
        brokerRow.style.display = r.value === 'broker_fee' ? '' : 'none'
      })
    })
  }

  const pairs = [
    ['theme_sidebar_bg', 'prev_sidebar', 'swatch_sidebar'],
    ['theme_accent',     'prev_accent',  'swatch_accent'],
    ['theme_content_bg', 'prev_content', 'swatch_content'],
  ]
  pairs.forEach(([name, prevId, swatchId]) => {
    const inp = document.querySelector(`input[name="${name}"]`)
    const prev = document.getElementById(prevId)
    const swatch = document.getElementById(swatchId)
    if (!inp || !prev) return
    inp.addEventListener('input', () => {
      prev.textContent = inp.value
      swatch.style.background = inp.value
    })
  })
})()
</script>
