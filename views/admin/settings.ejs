<% if (saved) { %><div class="adm-alert adm-alert-success">✅ บันทึกการตั้งค่าเรียบร้อย</div><% } %>

<form action="/admin/settings" method="POST">
<div class="adm-settings-grid">

  <!-- Insurance Rates -->
  <div class="adm-card">
    <div class="adm-card-title">💰 อัตราเบี้ยประกัน</div>
    <div class="adm-settings-note">อัตราคิดเป็น % ของมูลค่ารถ (เช่น 0.042 = 4.2%)</div>

    <div class="adm-settings-section">
      <div class="adm-settings-header adm-type-class1-bg">ประกันชั้น 1</div>
      <div class="adm-settings-row">
        <label>อัตราเบี้ย (%)</label>
        <input type="number" name="class1_rate" value="<%= settings.class1_rate||'0.042' %>" step="0.001" min="0.001" max="0.2">
        <span class="adm-settings-hint"><%= ((parseFloat(settings.class1_rate||0.042))*100).toFixed(1) %>%</span>
      </div>
      <div class="adm-settings-row">
        <label>เบี้ยขั้นต่ำ (บาท)</label>
        <input type="number" name="class1_min" value="<%= settings.class1_min||'12000' %>" step="500" min="0">
      </div>
    </div>

    <div class="adm-settings-section">
      <div class="adm-settings-header adm-type-class2plus-bg">ประกันชั้น 2+</div>
      <div class="adm-settings-row">
        <label>อัตราเบี้ย (%)</label>
        <input type="number" name="class2plus_rate" value="<%= settings.class2plus_rate||'0.022' %>" step="0.001" min="0.001" max="0.2">
        <span class="adm-settings-hint"><%= ((parseFloat(settings.class2plus_rate||0.022))*100).toFixed(1) %>%</span>
      </div>
      <div class="adm-settings-row">
        <label>เบี้ยขั้นต่ำ (บาท)</label>
        <input type="number" name="class2plus_min" value="<%= settings.class2plus_min||'7000' %>" step="500" min="0">
      </div>
    </div>

    <div class="adm-settings-section">
      <div class="adm-settings-header adm-type-class3plus-bg">ประกันชั้น 3+</div>
      <div class="adm-settings-row">
        <label>อัตราเบี้ย (%)</label>
        <input type="number" name="class3plus_rate" value="<%= settings.class3plus_rate||'0.010' %>" step="0.001" min="0.001" max="0.2">
        <span class="adm-settings-hint"><%= ((parseFloat(settings.class3plus_rate||0.010))*100).toFixed(1) %>%</span>
      </div>
      <div class="adm-settings-row">
        <label>เบี้ยขั้นต่ำ (บาท)</label>
        <input type="number" name="class3plus_min" value="<%= settings.class3plus_min||'3500' %>" step="500" min="0">
      </div>
    </div>
  </div>

  <!-- Site Info -->
  <div class="adm-card">
    <div class="adm-card-title">🏢 ข้อมูลติดต่อเว็บไซต์</div>
    <div class="adm-settings-row">
      <label>เบอร์โทรสายด่วน</label>
      <input type="text" name="site_phone" value="<%= settings.site_phone||'' %>" placeholder="02-xxx-xxxx">
    </div>
    <div class="adm-settings-row">
      <label>อีเมลติดต่อ</label>
      <input type="email" name="site_email" value="<%= settings.site_email||'' %>" placeholder="info@...">
    </div>
  </div>

</div>

<div class="adm-settings-footer">
  <button type="submit" class="adm-btn adm-btn-primary adm-btn-lg">💾 บันทึกการตั้งค่า</button>
</div>
</form>
