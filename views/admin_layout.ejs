<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/style.css">
  <style>
    :root {
      --adm-sidebar: <%= (locals.themeSettings && locals.themeSettings.theme_sidebar_bg) || '#0f172a' %>;
      --adm-accent:  <%= (locals.themeSettings && locals.themeSettings.theme_accent)     || '#1a56db' %>;
      --adm-content-bg: <%= (locals.themeSettings && locals.themeSettings.theme_content_bg) || '#f1f5f9' %>;
    }
  </style>
</head>
<body class="admin-body">
<div class="adm-wrap">

  <!-- SIDEBAR -->
  <aside class="adm-sidebar">
    <div class="adm-logo">
      <span class="adm-logo-icon"><i data-lucide="shield-check"></i></span>
      <span>Admin Panel</span>
    </div>
    <nav class="adm-nav">
      <% const menu = [
        { href:'/admin',              icon:'layout-dashboard', label:'Dashboard',        key:'dashboard' },
        { href:'/admin/leads',        icon:'users',            label:'Leads ลูกค้า',     key:'leads', badge:'leads' },
        { href:'/admin/reports',      icon:'bar-chart-2',      label:'รายงาน',           key:'reports',     notAffiliate:true },
        { href:'/admin/affiliates',   icon:'handshake',        label:'Affiliates',        key:'affiliates',  superadmin:true },
        { href:'/admin/settings',     icon:'settings',         label:'ตั้งค่า',          key:'settings' },
        { href:'/admin/line',         icon:'message-circle',   label:'LINE Chat',         key:'line', badge:'line', notAffiliate:true },
        { href:'/admin/admins',       icon:'key-round',        label:'จัดการ Admin',     key:'admins',      superadmin:true },
        { href:'/admin/bot-knowledge', icon:'brain',            label:'สอนบอท',           key:'bot',         notAffiliate:true },
        { href:'/admin/companies',    icon:'building-2',       label:'บริษัทประกัน',     key:'companies',   superadmin:true },
        { href:'/admin/scraper',      icon:'bot',              label:'Scraper',           key:'scraper',     superadmin:true },
        { href:'/admin/tracking',     icon:'map-pin',          label:'Visitor Tracking',  key:'tracking',    superadmin:true },
      ] %>
      <% menu.forEach(item => { %>
        <% const isSA = admin && admin.role === 'superadmin' %>
        <% const isAff = admin && admin.role === 'affiliate' %>
        <% if ((!item.superadmin || isSA) && (!item.notAffiliate || !isAff)) { %>
        <a href="<%= item.href %>" class="adm-nav-link <%= activePage===item.key ? 'active' : '' %>"
           <% if(item.badge){%>data-badge="<%= item.badge %>"<% } %>>
          <span class="adm-nav-icon"><i data-lucide="<%= item.icon %>"></i></span>
          <span><%= item.label %></span>
          <% if(item.badge){%><span class="adm-badge" id="badge_<%= item.badge %>" style="display:none">0</span><% } %>
        </a>
        <% } %>
      <% }) %>
      <div class="adm-nav-divider"></div>
      <a href="/" target="_blank" class="adm-nav-link">
        <span class="adm-nav-icon"><i data-lucide="globe"></i></span>
        <span>หน้าเว็บหลัก</span>
      </a>
      <a href="/admin/logout" class="adm-nav-link logout">
        <span class="adm-nav-icon"><i data-lucide="log-out"></i></span>
        <span>ออกจากระบบ</span>
      </a>
    </nav>
    <div class="adm-sidebar-foot">v1.0 · <%= new Date().getFullYear() %></div>
  </aside>

  <!-- MAIN -->
  <div class="adm-main">
    <header class="adm-topbar">
      <div class="adm-topbar-left">
        <button class="adm-menu-btn" onclick="document.querySelector('.adm-sidebar').classList.toggle('open')"><i data-lucide="menu"></i></button>
        <h1 class="adm-page-title"><%= title %></h1>
      </div>
      <div class="adm-topbar-right">
        <span class="adm-user">
          <i data-lucide="user" class="adm-topbar-icon"></i>
          <%= admin?.full_name || admin?.username %>
          <% if (admin?.role === 'affiliate') { %><span style="font-size:10px;background:#7c3aed;color:#fff;padding:1px 6px;border-radius:10px;margin-left:4px">Affiliate</span><% } %>
          <% if (admin?.role === 'agent') { %><span style="font-size:10px;background:#0891b2;color:#fff;padding:1px 6px;border-radius:10px;margin-left:4px">Staff</span><% } %>
        </span>
        <span class="adm-date"><%= new Date().toLocaleDateString('th-TH',{day:'numeric',month:'short',year:'2-digit'}) %></span>
        <a href="/admin/logout" class="adm-logout-btn">ออก</a>
      </div>
    </header>

    <div class="adm-content">
      <%- body %>
    </div>
  </div>

</div>
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
<script src="/public/js/admin.js"></script>
<script>
lucide.createIcons()
;(function pollNotifications() {
  fetch('/admin/api/notifications')
    .then(r => r.json())
    .then(data => {
      ['leads','line'].forEach(type => {
        const el = document.getElementById('badge_' + type)
        if (!el) return
        const count = data[type] || 0
        el.textContent = count
        el.style.display = count > 0 ? 'inline-flex' : 'none'
      })
    })
    .catch(() => {})
  setTimeout(pollNotifications, 30000)
})()
</script>
</body>
</html>
