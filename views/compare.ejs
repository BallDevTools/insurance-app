<section class="front-page-head">
  <div class="container">
    <div class="front-page-head-row">
      <a href="/" class="front-back-link">กลับไปหน้าแรก</a>
      <span class="front-pill">Compare Plans</span>
    </div>
    <h1>เปรียบเทียบแผนประกันจากข้อมูลจริงในระบบเดิม</h1>
    <p class="front-page-sub">หน้า compare นี้ยังใช้ query เดิมและ hidden submit form เดิมทุกจุด เพื่อส่งต่อเข้า flow `/quote` ตามระบบปัจจุบัน</p>
  </div>
</section>

<section class="front-compare-shell-v2">
  <div class="container">
    <form action="/compare" method="GET" class="front-compare-filter-v2">
      <div class="front-form-grid front-form-grid-compare">
        <div class="front-field">
          <label>ยี่ห้อรถ</label>
          <div class="select-wrapper">
            <select id="car_brand_id" name="brand_id" required>
              <option value="">เลือกยี่ห้อ</option>
              <% brands.forEach(b => { %>
                <option value="<%= b.id %>" <%= String(selected.brand_id) === String(b.id) ? 'selected' : '' %>><%= b.name %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="front-field">
          <label>รุ่นรถ</label>
          <div class="select-wrapper">
            <select id="car_model_id" name="model_id" required data-default-model-id="<%= selected.model_id || '' %>">
              <option value="">เลือกรุ่นรถ</option>
              <% if (models && models.length > 0) { %>
                <% models.forEach(m => { %>
                  <option value="<%= m.id %>" <%= String(selected.model_id) === String(m.id) ? 'selected' : '' %>><%= m.name %></option>
                <% }) %>
              <% } %>
            </select>
          </div>
        </div>

        <div class="front-field">
          <label>ปีรถ</label>
          <div class="select-wrapper">
            <select name="year" required>
              <option value="">เลือกปี</option>
              <% years.forEach(y => { %>
                <option value="<%= y %>" <%= String(selected.year) === String(y) ? 'selected' : '' %>><%= y %> (พ.ศ. <%= y + 543 %>)</option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="front-field">
          <label>จังหวัด</label>
          <div class="select-wrapper">
            <select name="province" required>
              <option value="">เลือกจังหวัด</option>
              <% provinces.forEach(p => { %>
                <option value="<%= p.name %>" <%= selected.province === p.name ? 'selected' : '' %>><%= p.name %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </div>

      <div class="front-cta-row front-cta-row-compare">
        <button type="submit" class="front-primary-btn">เปรียบเทียบราคา</button>
      </div>
    </form>

    <% if (comparisons && selectedModel) { %>
      <div class="front-summary-card front-summary-card-compare">
        <div class="front-summary-item">
          <small>รถที่เลือก</small>
          <strong><%= selectedModel.brand_name %> <%= selectedModel.model_name %></strong>
        </div>
        <div class="front-summary-item">
          <small>ปีรถ</small>
          <strong><%= selected.year %></strong>
        </div>
        <div class="front-summary-item">
          <small>จังหวัด</small>
          <strong><%= selected.province %></strong>
        </div>
      </div>

      <div class="front-compare-grid-v2">
        <% const types = ['class1','class2plus','class3plus'] %>
        <% const typeLabels = { class1:'ประกันชั้น 1', class2plus:'ประกันชั้น 2+', class3plus:'ประกันชั้น 3+' } %>
        <% const typeColors = { class1:'#153c3c', class2plus:'#6d5b31', class3plus:'#2f7a55' } %>

        <% types.forEach(type => { %>
          <% const pkgs = comparisons[type] %>
          <% const cfg = INSURANCE_TYPES[type] %>
          <% const minPkg = pkgs.length > 0 ? pkgs[0] : null %>
          <% const minPrice = minPkg ? parseFloat(minPkg.premium_discounted || minPkg.premium_amount) : null %>
          <article class="front-compare-card-v2">
            <div class="front-compare-card-head-v2" style="background:<%= typeColors[type] %>">
              <span class="front-plan-badge"><%= typeLabels[type] %></span>
              <% if (minPrice) { %>
                <strong><%= formatNumber(minPrice) %></strong>
                <small>บาท/ปี</small>
              <% } else { %>
                <strong>ยังไม่มีราคา</strong>
                <small>ติดต่อทีมงานเพื่อเช็กต่อ</small>
              <% } %>
            </div>

            <div class="front-compare-card-body-v2">
              <% if (pkgs.length > 0) { %>
                <div class="front-compare-mini-list">
                  <% pkgs.slice(0, 5).forEach(function(pkg, pi) { %>
                    <div class="front-compare-mini-row">
                      <span><%= pi === 0 ? 'แนะนำ ' : '' %><%= pkg.company_name %></span>
                      <strong><%= formatNumber(pkg.premium_discounted || pkg.premium_amount) %></strong>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <p class="front-empty-small">ยังไม่พบข้อมูลสำหรับรุ่น/ปีนี้</p>
              <% } %>

              <ul class="front-check-list front-check-list-compact">
                <% const coverageLabels = {
                  ownDamage:'คุ้มครองรถของคุณ',
                  thirdPartyBody:'คุ้มครองบุคคลภายนอก',
                  thirdPartyProperty:'คุ้มครองทรัพย์สินคู่กรณี',
                  theft:'ไฟไหม้/โจรกรรม',
                  flood:'น้ำท่วม',
                  personalAccident:'อุบัติเหตุส่วนบุคคล',
                  medicalExpense:'ค่ารักษาพยาบาล'
                } %>
                <% Object.entries(cfg.coverage).forEach(([key, val]) => { %>
                  <% if (coverageLabels[key]) { %>
                    <li class="<%= val === false ? 'muted' : '' %>"><%= coverageLabels[key] %></li>
                  <% } %>
                <% }) %>
              </ul>

              <% if (pkgs.length > 0) { %>
                <a href="#" onclick="event.preventDefault(); document.getElementById('quoteForm_<%= type %>').submit()" class="front-primary-btn front-btn-block">ใช้แผนนี้ต่อ</a>
              <% } else { %>
                <a href="/" class="front-secondary-btn front-btn-block">กลับไปเช็คราคา</a>
              <% } %>
            </div>
          </article>
        <% }) %>
      </div>

      <% types.forEach(type => { %>
        <form id="quoteForm_<%= type %>" action="/quote" method="POST" style="display:none">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="car_brand" value="<%= selectedModel.brand_name %>">
          <input type="hidden" name="car_model" value="<%= selectedModel.model_name %>">
          <input type="hidden" name="car_model_id" value="<%= selectedModel.id %>">
          <input type="hidden" name="car_year" value="<%= selected.year %>">
          <input type="hidden" name="license_plate" value="กข 0000">
          <input type="hidden" name="province" value="<%= selected.province || 'กรุงเทพมหานคร' %>">
          <input type="hidden" name="insurance_type" value="<%= type %>">
        </form>
      <% }) %>
    <% } %>
  </div>
</section>
