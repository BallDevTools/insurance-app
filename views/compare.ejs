<script>
function togglePkgCov(id, btn) {
  var el = document.getElementById(id)
  if (!el) return
  el.classList.toggle('is-open')
  btn.textContent = el.classList.contains('is-open') ? 'ซ่อนความคุ้มครอง' : 'ดูความคุ้มครองทั้งหมด'
}

document.getElementById('sortSelect')?.addEventListener('change', function() {
  var list = document.getElementById('pkgList')
  if (!list) return
  var cards = Array.from(list.querySelectorAll('.pkg'))
  cards.sort(function(a, b) {
    var pa = parseFloat(a.dataset.price) || 0
    var pb = parseFloat(b.dataset.price) || 0
    return this.value === 'asc' ? pa - pb : pb - pa
  }.bind(this))
  cards.forEach(function(c) { list.appendChild(c) })
})

// compare (Mode B only)
var PKG_DATA = <%- JSON.stringify((sameClassPackages || []).map(function(p) {
  return {
    id: p.id,
    company: p.company_name,
    insurance_class: p.insurance_class,
    price: parseFloat(p.premium_discounted && parseFloat(p.premium_discounted) < parseFloat(p.premium_amount) ? p.premium_discounted : p.premium_amount) || 0,
    repair_type: p.repair_type || null,
    has_flood: p.has_flood ? 1 : 0,
    coverage: p.coverage || {}
  }
})).replace(/<\//g, '<\\/') %>;
var LINE_URL = '<%= locals.lineOaUrl || "/click/line?ref=compare" %>';

;(function() {
  if (!PKG_DATA.length) return
  var selected = []
  var MAX = 3

  function numFmt(n) { return Number(n).toLocaleString('th-TH') }

  function updateBar() {
    var bar   = document.getElementById('compareBar')
    var badge = document.getElementById('compareBarBadge')
    var text  = document.getElementById('compareBarText')
    var go    = document.getElementById('compareBarGo')
    if (!bar) return
    bar.classList.toggle('is-visible', selected.length > 0)
    badge.textContent = selected.length
    var remaining = MAX - selected.length
    text.textContent = selected.length >= MAX
      ? 'แผน · เต็มแล้ว! (สูงสุด ' + MAX + ' แผน)'
      : 'แผน · เพิ่มอีก ' + remaining + ' แผน เพื่อเปรียบเทียบ'
    go.disabled = selected.length < 2
  }

  function setBtn(idx, active) {
    var btn = document.querySelector('.btn-compare[data-idx="' + idx + '"]')
    if (!btn) return
    btn.classList.toggle('is-selected', active)
    btn.textContent = active ? '✓ เพิ่มแล้ว' : '+ เปรียบเทียบ'
  }

  function addPkg(idx) {
    if (selected.indexOf(idx) !== -1 || selected.length >= MAX) return
    selected.push(idx)
    setBtn(idx, true)
    updateBar()
  }

  function removePkg(idx) {
    var i = selected.indexOf(idx)
    if (i === -1) return
    selected.splice(i, 1)
    setBtn(idx, false)
    updateBar()
  }

  document.querySelectorAll('.btn-compare').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var idx = parseInt(this.dataset.idx)
      selected.indexOf(idx) !== -1 ? removePkg(idx) : addPkg(idx)
    })
  })

  document.getElementById('compareBarClear')?.addEventListener('click', function() {
    selected.slice().forEach(removePkg)
  })
  document.getElementById('compareBarGo')?.addEventListener('click', goCompare)

  function goCompare() {
    var ids = selected.map(function(idx) { return PKG_DATA[idx] && PKG_DATA[idx].id }).filter(Boolean).join(',')
    if (!ids) return
    window.location.href = '/compare-view?pkg_ids=' + ids
  }

})()
</script>
