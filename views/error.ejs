<section class="front-error-shell">
  <div class="container">
    <div class="front-error-card">
      <span class="front-error-icon"><%= code === 429 ? '429' : '!' %></span>
      <h1><%= title %></h1>
      <p><%= message || 'เกิดข้อผิดพลาด กรุณาลองใหม่อีกครั้ง' %></p>
      <div class="front-error-actions">
        <a href="/" class="front-primary-btn">กลับหน้าแรก</a>
        <a href="/compare" class="front-secondary-btn">ไปหน้าเปรียบเทียบ</a>
      </div>
    </div>
  </div>
</section>
