<section class="front-hero">
  <div class="container">
    <div class="front-hero-grid">
      <div class="front-hero-copy">
        <span class="front-pill">เช็คราคาไว เปรียบเทียบต่อได้ และคงระบบเดิมไว้ครบ</span>
        <h1>เช็คราคาประกันรถแบบใช้งานง่ายมากขึ้น</h1>
        <p>ดีไซน์ใหม่ให้สบายตาและตัดสินใจง่ายขึ้น แต่ยังใช้ logic เดิมของระบบทั้งหมด ทั้งการโหลดรุ่นรถอัตโนมัติ การ submit ฟอร์ม และการไปหน้าผลลัพธ์ผ่าน lead token เดิม</p>

        <div class="front-hero-points">
          <span>ดูราคาเบื้องต้นได้ไว</span>
          <span>คุยต่อทาง LINE ได้ทันที</span>
          <span>ใช้ข้อมูลจริงจากระบบเดิม</span>
        </div>
      </div>

      <div class="front-form-card-wrap">
        <div class="front-form-card-head">
          <span class="front-pill">Step 1</span>
          <h2>เริ่มจากข้อมูลรถที่จำเป็น</h2>
          <p>กรอกเฉพาะข้อมูลที่ระบบต้องใช้จริงก่อน เพื่อพาไปดูราคาเบื้องต้นในขั้นถัดไป</p>
        </div>

        <form action="/quote" method="POST" id="carForm" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="utm_source" value="<%= utm.source || '' %>">
          <input type="hidden" name="utm_campaign" value="<%= utm.campaign || '' %>">
          <input type="hidden" name="utm_medium" value="<%= utm.medium || '' %>">
          <input type="hidden" name="utm_content" value="<%= utm.content || '' %>">

          <div class="front-form-grid">
            <div class="front-field">
              <label for="car_brand_id">ยี่ห้อรถ</label>
              <div class="select-wrapper">
                <select id="car_brand_id" name="car_brand_id" class="<%= errors.car_brand ? 'error' : '' %>" required>
                  <option value="">เลือกยี่ห้อ</option>
                  <% brands.forEach(b => { %>
                    <option value="<%= b.id %>" <%= old.car_brand_id == b.id ? 'selected' : '' %>><%= b.name %></option>
                  <% }) %>
                </select>
              </div>
              <input type="hidden" id="car_brand" name="car_brand" value="<%= old.car_brand || '' %>">
              <% if (errors.car_brand) { %><span class="field-error"><%= errors.car_brand %></span><% } %>
            </div>

            <div class="front-field">
              <label for="car_model_id">รุ่นรถ</label>
              <div class="select-wrapper">
                <select id="car_model_id" name="car_model_id" class="<%= errors.car_model ? 'error' : '' %>" required data-default-model-id="<%= old.car_model_id || '' %>">
                  <option value="">เลือกรุ่นรถ</option>
                  <% if (old.car_model_id) { %>
                    <option value="<%= old.car_model_id %>" selected><%= old.car_model %></option>
                  <% } %>
                </select>
              </div>
              <input type="hidden" id="car_model" name="car_model" value="<%= old.car_model || '' %>">
              <% if (errors.car_model) { %><span class="field-error"><%= errors.car_model %></span><% } %>
            </div>

            <div class="front-field">
              <label for="car_year">ปีรถ</label>
              <div class="select-wrapper">
                <select id="car_year" name="car_year" class="<%= errors.car_year ? 'error' : '' %>" required>
                  <option value="">เลือกปี</option>
                  <% years.forEach(y => { %>
                    <option value="<%= y %>" <%= old.car_year == y ? 'selected' : '' %>><%= y %> (พ.ศ. <%= y + 543 %>)</option>
                  <% }) %>
                </select>
              </div>
              <% if (errors.car_year) { %><span class="field-error"><%= errors.car_year %></span><% } %>
            </div>

            <div class="front-field">
              <label for="province">จังหวัด</label>
              <div class="select-wrapper">
                <select id="province" name="province" class="<%= errors.province ? 'error' : '' %>" required>
                  <option value="">เลือกจังหวัด</option>
                  <% provinces.forEach(p => { %>
                    <option value="<%= p.name %>" <%= old.province === p.name ? 'selected' : '' %>><%= p.name %></option>
                  <% }) %>
                </select>
              </div>
              <% if (errors.province) { %><span class="field-error"><%= errors.province %></span><% } %>
            </div>

            <div class="front-field front-field-full">
              <label for="license_plate">ทะเบียนรถ</label>
              <input type="text" id="license_plate" name="license_plate" placeholder="เช่น กข 1234" value="<%= old.license_plate || '' %>" class="<%= errors.license_plate ? 'error' : '' %>" maxlength="15" required>
              <% if (errors.license_plate) { %><span class="field-error"><%= errors.license_plate %></span><% } %>
            </div>
          </div>

          <div class="front-plan-picker">
            <div class="front-plan-copy">
              <h3>เลือกประเภทประกันที่สนใจ</h3>
              <p>ยังคงชื่อ value เดิมของระบบไว้ทั้งหมด เพื่อไม่ให้ logic submit เปลี่ยน</p>
            </div>

            <div class="front-plan-grid">
              <label class="front-plan-card">
                <input type="radio" name="insurance_type" value="class1" <%= old.insurance_type === 'class1' ? 'checked' : '' %> required>
                <span class="front-plan-badge">ชั้น 1</span>
                <strong>คุ้มครองสูงสุด</strong>
                <small>เหมาะกับคนที่อยากได้ความมั่นใจสูง</small>
              </label>

              <label class="front-plan-card">
                <input type="radio" name="insurance_type" value="class2plus" <%= old.insurance_type === 'class2plus' ? 'checked' : '' %>>
                <span class="front-plan-badge">ชั้น 2+</span>
                <strong>สมดุลราคาและความคุ้มครอง</strong>
                <small>ตัวเลือกยอดนิยมสำหรับการใช้งานทั่วไป</small>
              </label>

              <label class="front-plan-card">
                <input type="radio" name="insurance_type" value="class3plus" <%= old.insurance_type === 'class3plus' ? 'checked' : '' %>>
                <span class="front-plan-badge">ชั้น 3+</span>
                <strong>เริ่มต้นประหยัดกว่า</strong>
                <small>เหมาะกับคนที่อยากดูราคาเบื้องต้นก่อน</small>
              </label>
            </div>
            <% if (errors.insurance_type) { %><span class="field-error"><%= errors.insurance_type %></span><% } %>
          </div>

          <details class="front-optional-box">
            <summary>เพิ่มข้อมูลติดต่อไว้ก่อนได้ แต่ยังไม่บังคับ</summary>
            <div class="front-form-grid front-form-grid-optional">
              <div class="front-field">
                <label for="name">ชื่อ</label>
                <input type="text" id="name" name="name" placeholder="ชื่อของคุณ" value="<%= old.name || '' %>" maxlength="200">
              </div>
              <div class="front-field">
                <label for="phone">เบอร์โทร</label>
                <input type="tel" id="phone" name="phone" placeholder="0XX-XXX-XXXX" value="<%= old.phone || '' %>" maxlength="12">
              </div>
            </div>
          </details>

          <div class="front-cta-row">
            <button type="submit" class="front-primary-btn" id="submitBtn">ดูราคาเบื้องต้น</button>
            <a href="/compare" class="front-secondary-btn">ไปหน้าเปรียบเทียบ</a>
          </div>
          <p class="front-note">ราคาที่แสดงในหน้าถัดไปเป็นราคาเบื้องต้นจากข้อมูลในระบบ และปุ่มติดต่อยัง track lead ตาม flow เดิมของระบบ</p>
        </form>
      </div>
    </div>
  </div>
</section>

<section class="front-section">
  <div class="container">
    <div class="front-section-head">
      <span class="front-pill">Why This Works</span>
      <h2>ออกแบบใหม่ให้ใช้ง่ายขึ้น แต่ไม่รื้อระบบหลังบ้าน</h2>
    </div>
    <div class="front-benefit-grid">
      <article class="front-benefit-card">
        <strong>คง field เดิม</strong>
        <p>ชื่อ field, id และ action ยังตรงกับ backend เดิม เพื่อให้ validation และการบันทึก lead ทำงานเหมือนเดิม</p>
      </article>
      <article class="front-benefit-card">
        <strong>คง AJAX เดิม</strong>
        <p>การโหลดรุ่นรถจาก `/api/models` ยังใช้ id เดิมของ select ดังนั้น JS เดิมยังทำงานต่อได้</p>
      </article>
      <article class="front-benefit-card">
        <strong>เปลี่ยนเฉพาะประสบการณ์</strong>
        <p>ย้าย visual language ให้ทันสมัยขึ้นในแบบปีนี้ แต่ไม่กระทบ flow ที่ระบบใช้อยู่จริง</p>
      </article>
    </div>
  </div>
</section>

<section class="front-section front-section-soft" id="faq">
  <div class="container">
    <div class="front-section-head">
      <span class="front-pill">FAQ</span>
      <h2>คำถามที่พบบ่อยก่อนเช็คราคา</h2>
    </div>
    <div class="front-faq-list">
      <article class="front-faq-item">
        <strong>ต้องกรอกข้อมูลเยอะไหม</strong>
        <p>ยังใช้ข้อมูลหลักของระบบเดิม แต่จัด UI ใหม่ให้อ่านง่ายและกรอกต่อได้เป็นจังหวะมากขึ้น</p>
      </article>
      <article class="front-faq-item">
        <strong>ข้อมูลรุ่นรถโหลดอัตโนมัติหรือไม่</strong>
        <p>ใช่ ระบบยังโหลดรุ่นรถอัตโนมัติจากฐานข้อมูลเดิมผ่าน AJAX เหมือนเดิม</p>
      </article>
      <article class="front-faq-item">
        <strong>หลังเห็นราคาแล้วทำอะไรต่อ</strong>
        <p>สามารถกดติดต่อทาง LINE หรือ Facebook ได้ทันที และระบบจะ track การกดตาม lead token เดิม</p>
      </article>
    </div>
  </div>
</section>
