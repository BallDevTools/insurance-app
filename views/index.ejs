<!-- HERO -->
<section class="front-hero">
  <div class="container">
    <div class="front-hero-grid">

      <!-- Left: Copy -->
      <div class="front-hero-copy">
        <div class="front-pill">✨ เปรียบเทียบแผนจาก 12+ บริษัทชั้นนำ</div>

        <h1>เช็คราคาประกันรถ<br><span style="color:var(--front-primary)">ใน 30 วินาที</span></h1>

        <p>เลือกยี่ห้อ รุ่น ปีรถ แล้วดูราคาเบื้องต้นได้ทันที<br>ไม่ต้องกรอกข้อมูลเยอะ ไม่ต้องรอนาน</p>

        <div class="pub-trust-row">
          <span class="pub-trust-item">✓ ไม่มีค่าธรรมเนียมซ่อนเร้น</span>
          <span class="pub-trust-item">✓ ใช้บริการฟรี 100%</span>
        </div>
      </div>

      <!-- Right: Form Card -->
      <div class="front-form-card-wrap">
        <div class="front-form-card-head">
          <h2>เช็คราคาประกัน</h2>
          <p>กรอกข้อมูลรถเพียงไม่กี่รายการ แล้วดูราคาเบื้องต้นได้ทันที</p>
        </div>

        <form action="/quote" method="POST" id="carForm" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="utm_source" value="<%= utm.source || '' %>">
          <input type="hidden" name="utm_campaign" value="<%= utm.campaign || '' %>">
          <input type="hidden" name="utm_medium" value="<%= utm.medium || '' %>">
          <input type="hidden" name="utm_content" value="<%= utm.content || '' %>">
          <input type="hidden" name="partial_token" id="partial_token" value="">

          <div class="front-form-grid">
            <div class="front-field">
              <label for="car_brand_id">ยี่ห้อรถ</label>
              <div class="select-wrapper">
                <select id="car_brand_id" name="car_brand_id" class="<%= errors.car_brand ? 'error' : '' %>" required>
                  <option value="">เลือกยี่ห้อ</option>
                  <% brands.forEach(b => { %>
                    <option value="<%= b.id %>" <%= old.car_brand_id == b.id ? 'selected' : '' %>><%= b.name %></option>
                  <% }) %>
                </select>
              </div>
              <input type="hidden" id="car_brand" name="car_brand" value="<%= old.car_brand || '' %>">
              <% if (errors.car_brand) { %><span class="field-error"><%= errors.car_brand %></span><% } %>
            </div>

            <div class="front-field">
              <label for="car_model_id">รุ่นรถ</label>
              <div class="select-wrapper">
                <select id="car_model_id" name="car_model_id" class="<%= errors.car_model ? 'error' : '' %>" required data-default-model-id="<%= old.car_model_id || '' %>">
                  <option value="">เลือกรุ่นรถ</option>
                  <% if (old.car_model_id) { %>
                    <option value="<%= old.car_model_id %>" selected><%= old.car_model %></option>
                  <% } %>
                </select>
              </div>
              <input type="hidden" id="car_model" name="car_model" value="<%= old.car_model || '' %>">
              <% if (errors.car_model) { %><span class="field-error"><%= errors.car_model %></span><% } %>
            </div>

            <div class="front-field">
              <label for="car_year">ปีรถ</label>
              <div class="select-wrapper">
                <select id="car_year" name="car_year" class="<%= errors.car_year ? 'error' : '' %>" required>
                  <option value="">เลือกปี</option>
                  <% years.forEach(y => { %>
                    <option value="<%= y %>" <%= old.car_year == y ? 'selected' : '' %>><%= y %> (พ.ศ. <%= y + 543 %>)</option>
                  <% }) %>
                </select>
              </div>
              <% if (errors.car_year) { %><span class="field-error"><%= errors.car_year %></span><% } %>
            </div>

          </div>

          <div class="front-plan-picker">
            <div class="front-plan-copy">
              <h3>ประเภทประกันที่สนใจ</h3>
              <p>เลือกแผนที่ตรงกับความต้องการ เพื่อดูราคาได้แม่นยำขึ้น</p>
            </div>
            <div class="front-plan-grid">
              <label class="front-plan-card">
                <input type="radio" name="insurance_type" value="class1" <%= old.insurance_type === 'class1' ? 'checked' : '' %> required>
                <span class="front-plan-badge">ชั้น 1</span>
                <strong>คุ้มครองสูงสุด</strong>
                <small>เหมาะกับคนที่อยากได้ความมั่นใจสูง</small>
              </label>
              <label class="front-plan-card">
                <input type="radio" name="insurance_type" value="class2plus" <%= old.insurance_type === 'class2plus' ? 'checked' : '' %>>
                <span class="front-plan-badge">ชั้น 2+</span>
                <strong>สมดุลราคาและความคุ้มครอง</strong>
                <small>ตัวเลือกยอดนิยมสำหรับการใช้งานทั่วไป</small>
              </label>
              <label class="front-plan-card">
                <input type="radio" name="insurance_type" value="class3plus" <%= old.insurance_type === 'class3plus' ? 'checked' : '' %>>
                <span class="front-plan-badge">ชั้น 3+</span>
                <strong>เริ่มต้นประหยัดกว่า</strong>
                <small>เหมาะกับคนที่อยากเริ่มต้นก่อน</small>
              </label>
            </div>
            <% if (errors.insurance_type) { %><span class="field-error"><%= errors.insurance_type %></span><% } %>
          </div>

          <details class="front-optional-box">
            <summary>เพิ่มข้อมูลติดต่อ (ไม่บังคับ)</summary>
            <div class="front-form-grid front-form-grid-optional">
              <div class="front-field">
                <label for="name">ชื่อ</label>
                <input type="text" id="name" name="name" placeholder="ชื่อของคุณ" value="<%= old.name || '' %>" maxlength="200">
              </div>
              <div class="front-field">
                <label for="phone">เบอร์โทร</label>
                <input type="tel" id="phone" name="phone" placeholder="0XX-XXX-XXXX" value="<%= old.phone || '' %>" maxlength="12">
              </div>
            </div>
          </details>

          <div class="front-cta-row">
            <button type="submit" class="front-primary-btn" id="submitBtn">ดูราคาเบื้องต้น →</button>
          </div>
          <p class="front-note">ราคาในหน้าถัดไปเป็นราคาเบื้องต้นจากข้อมูลจริง</p>
        </form>

        <!-- Concierge CTA -->
        <div class="concierge-divider">
          <span>หรือ</span>
        </div>
        <div class="concierge-cta-row">
          <button type="button" class="concierge-trigger-btn" id="conciergeToggle">
            📞 ให้เราโทรกลับ
          </button>
          <% if (lineOaUrl) { %>
          <a href="<%= lineOaUrl %>" class="concierge-line-btn" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.03 2 11c0 3.13 1.73 5.88 4.34 7.56-.19.67-.7 2.44-.8 2.82-.12.47.18.46.37.34.15-.1 2.42-1.6 3.4-2.25.55.08 1.12.12 1.69.12 5.52 0 10-4.03 10-9C22 6.03 17.52 2 12 2zm-5 12.5v-5h1.5v3.5H11v1.5H7zm4 0v-5h1.5v5H11zm5.5 0h-1.5l-2-3v3H11.5v-5H13l2 3v-3h1.5v5z"/></svg>
            คุยทาง LINE เลย
          </a>
          <% } %>
        </div>

        <!-- Concierge Panel (hidden by default) -->
        <div id="conciergePanel" class="concierge-panel" style="display:none">
          <div class="concierge-panel-head">
            <strong>ให้เราโทรกลับหาคุณ</strong>
            <p>ทีมงานจะโทรหาคุณภายใน 5 นาที เพื่อช่วยเลือกแผนที่เหมาะสม</p>
          </div>
          <div class="front-form-grid front-form-grid-optional">
            <div class="front-field">
              <label for="c_name">ชื่อ (ไม่บังคับ)</label>
              <input type="text" id="c_name" name="c_name" placeholder="ชื่อของคุณ" maxlength="200" autocomplete="name">
            </div>
            <div class="front-field">
              <label for="c_phone">เบอร์โทร <span style="color:#dc2626">*</span></label>
              <input type="tel" id="c_phone" name="c_phone" placeholder="0XX-XXX-XXXX" maxlength="12" autocomplete="tel">
              <span class="field-error" id="c_phone_err" style="display:none">กรุณากรอกเบอร์โทรให้ถูกต้อง</span>
            </div>
          </div>
          <button type="button" class="front-primary-btn" id="conciergeSubmit" style="width:100%;margin-top:.5rem">
            ให้เราโทรกลับ →
          </button>
          <div id="conciergeSuccess" class="concierge-success" style="display:none">
            ✅ รับแล้วครับ! ทีมจะโทรกลับหาคุณเร็วๆ นี้
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<!-- TRUST STRIP -->
<section class="pub-trust-strip" id="insurers">
  <div class="container">
    <div class="pub-trust-stats">
      <div class="pub-trust-stat">
        <div class="pub-trust-stat-icon">🛡️</div>
        <div class="pub-trust-stat-num">12+</div>
        <div class="pub-trust-stat-lbl">บริษัทประกันชั้นนำ</div>
      </div>
      <div class="pub-trust-stat">
        <div class="pub-trust-stat-icon">👥</div>
        <div class="pub-trust-stat-num">50,000+</div>
        <div class="pub-trust-stat-lbl">ลูกค้าที่ไว้วางใจ</div>
      </div>
      <div class="pub-trust-stat">
        <div class="pub-trust-stat-icon">⭐</div>
        <div class="pub-trust-stat-num">4.8/5</div>
        <div class="pub-trust-stat-lbl">คะแนนรีวิว</div>
      </div>
    </div>
    <div class="pub-insurers-row">
      <p class="pub-insurers-label">บริษัทประกันภัยชั้นนำที่ร่วมงานกับเรา</p>
      <div class="pub-insurers-list">
        <span>วิริยะ</span>
        <span>กรุงเทพประกันภัย</span>
        <span>เมืองไทยประกันภัย</span>
        <span>AXA</span>
        <span>AIG</span>
        <span>Allianz</span>
      </div>
    </div>
  </div>
</section>

<!-- WHY US -->
<section class="front-section" id="about">
  <div class="container">
    <div class="front-section-head">
      <h2>ทำไมต้องเลือกเรา</h2>
      <p>เราทำให้การเลือกประกันรถง่ายและรวดเร็ว ไม่มีค่าธรรมเนียมซ่อนเร้น</p>
    </div>
    <div class="front-benefit-grid">
      <article class="front-benefit-card">
        <div class="pub-benefit-icon">⚡</div>
        <strong>เช็คราคาใน 30 วินาที</strong>
        <p>เพียงเลือกรถและดูราคาจากหลายบริษัท ไม่ต้องรอนาน ไม่ต้องกรอกข้อมูลเยอะ</p>
      </article>
      <article class="front-benefit-card">
        <div class="pub-benefit-icon">🛡️</div>
        <strong>เปรียบเทียบแผนประกันชั้นนำ</strong>
        <p>เราคัดสรรแผนประกันจากบริษัทชั้นนำ มีคุณภาพ ราคาใสสะอาด ครบจบในที่เดียว</p>
      </article>
      <article class="front-benefit-card">
        <div class="pub-benefit-icon">⏰</div>
        <strong>ขอใบเสนอราคาภายใน 5 นาที</strong>
        <p>ส่งข้อมูลผ่าน LINE ทีมเราจะส่งใบเสนอราคาเต็มให้ภายใน 5 นาที</p>
      </article>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="front-section front-section-soft" id="faq">
  <div class="container">
    <div class="front-section-head">
      <h2>คำถามที่พบบ่อย</h2>
      <p>มีคำถามเพิ่มเติม? เรายินดีตอบทุกข้อสงสัย</p>
    </div>
    <div class="front-faq-list">
      <article class="front-faq-item">
        <strong>ใช้บริการฟรีจริงไหม?</strong>
        <p>ใช่ครับ บริการของเราฟรี 100% ทั้งการเช็คราคาและขอใบเสนอราคา ไม่มีค่าธรรมเนียมใดๆ</p>
      </article>
      <article class="front-faq-item">
        <strong>ราคาที่เห็นคือราคาจริงไหม?</strong>
        <p>ราคาที่แสดงเป็นราคาเบื้องต้นจากบริษัทประกัน ราคาจริงอาจแตกต่างเล็กน้อยตามรายละเอียดรถและประวัติการใช้งาน</p>
      </article>
      <article class="front-faq-item">
        <strong>ต้องเตรียมเอกสารอะไรบ้าง?</strong>
        <p>สำเนาทะเบียนรถ บัตรประชาชน และใบขับขี่ ทีมเราจะแจ้งรายละเอียดเพิ่มเติมเมื่อคุณตัดสินใจซื้อ</p>
      </article>
      <article class="front-faq-item">
        <strong>หลังจากกรอกข้อมูลแล้วจะเห็นอะไร?</strong>
        <p>คุณจะเห็นราคาเบื้องต้นและตัวเลือกแผนประกันที่เหมาะกับรถ พร้อมช่องทางติดต่อทีมงานได้ทันที</p>
      </article>
      <article class="front-faq-item">
        <strong>ถ้ามีปัญหาหลังซื้อประกันติดต่อใคร?</strong>
        <p>ติดต่อทีมเราผ่าน LINE หรือโทรได้ตลอด เราพร้อมช่วยเหลือและประสานงานกับบริษัทประกันให้</p>
      </article>
    </div>
  </div>
</section>
