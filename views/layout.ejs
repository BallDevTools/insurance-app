<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= siteName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body class="public-site">
  <header class="public-nav-wrap">
    <div class="container">
      <nav class="public-nav">
        <a href="/" class="public-brand">
          <span class="public-brand-mark">▣</span>
          <span class="public-brand-copy">
            <strong>ประกันรถดีดี</strong>
            <small>Calm premium insurance experience</small>
          </span>
        </a>

        <div class="public-nav-links">
          <a href="/">เช็คราคา</a>
          <a href="/compare">เปรียบเทียบแผน</a>
          <a href="/#faq">คำถามที่พบบ่อย</a>
        </div>

        <div class="public-nav-actions">
          <a href="tel:02-xxx-xxxx" class="public-nav-phone">02-xxx-xxxx</a>
          <a href="/compare" class="public-nav-line">ติดต่อทาง LINE</a>
        </div>
      </nav>
    </div>
  </header>

  <main class="public-main">
    <%- body %>
  </main>

  <footer class="public-footer">
    <div class="container">
      <div class="public-footer-grid">
        <div>
          <div class="public-footer-brand">ประกันรถดีดี</div>
          <p>ประสบการณ์เช็คราคาประกันที่อ่านง่ายขึ้น ดูสบายตา และยังทำงานบนระบบเดิมของโปรเจคนี้ครบเหมือนเดิม</p>
        </div>
        <div>
          <h4>บริการ</h4>
          <ul>
            <li><a href="/">เช็คราคาเบื้องต้น</a></li>
            <li><a href="/compare">เปรียบเทียบประกัน</a></li>
            <li><a href="/#faq">คำถามที่พบบ่อย</a></li>
          </ul>
        </div>
        <div>
          <h4>ติดต่อ</h4>
          <ul>
            <li><a href="tel:02-xxx-xxxx">โทร 02-xxx-xxxx</a></li>
            <li><a href="mailto:info@insurance.co.th">info@insurance.co.th</a></li>
            <li>ทุกวัน 08:00 - 18:00</li>
          </ul>
        </div>
      </div>
      <div class="public-footer-bottom">
        <p>&copy; <%= year %> <%= siteName %></p>
      </div>
    </div>
  </footer>

  <script src="/public/js/main.js"></script>
</body>
</html>
