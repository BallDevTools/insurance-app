<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= siteName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/style.css">
  <link rel="stylesheet" href="/public/css/public.css">
  <% if (locals.gtmHeadCode) { %><%- locals.gtmHeadCode %><% } %>
</head>
<body class="public-site">
<% if (locals.gtmBodyCode) { %><%- locals.gtmBodyCode %><% } %>

<nav class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__logo">
      <div class="nav__logo-mark">IW</div>
      <span class="nav__logo-text">ประกัน<span>รถดีดี</span></span>
    </a>
    <div class="nav__links">
      <a href="/#how">วิธีการใช้งาน</a>
      <a href="/#faq">คำถามที่พบบ่อย</a>
      <a href="/compare">เปรียบเทียบ</a>
    </div>
    <% if (locals.sitePhone) { %>
    <div class="nav__phone">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.13 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      <%= locals.sitePhone %>
    </div>
    <% } %>
    <a href="<%= locals.lineOaUrl || '#' %>" class="nav__cta" target="_blank" rel="noopener"><img src="/public/images/line-icon.png" width="20" height="20" style="border-radius:4px;vertical-align:middle;margin-right:6px;" alt="LINE"> ติดต่อทาง LINE</a>
    <button class="nav__burger" id="navBurger" aria-label="เมนู" type="button">
      <span></span>
    </button>
  </div>
</nav>

<main style="flex:1">
  <%- body %>
</main>

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <div class="footer__logo">
          <div class="nav__logo-mark" style="width:28px;height:28px;font-size:13px">IW</div>
          <span style="color:#fff;font-weight:700;font-size:17px">ประกัน<span style="color:var(--cyan)">รถดีดี</span></span>
        </div>
        <p>เปรียบเทียบและเลือกประกันรถยนต์จาก 12+ บริษัทชั้นนำ ง่าย รวดเร็ว ใสสะอาด</p>
        <div class="footer__socials">
          <% if (locals.lineOaUrl) { %>
          <a href="<%= locals.lineOaUrl %>" target="_blank" rel="noopener" title="LINE OA">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63h-1.755v1.125h1.755c.349 0 .63.283.63.63s-.281.628-.63.628h-2.385a.631.631 0 0 1-.627-.629V8.108c0-.345.281-.63.63-.63h2.385c.346 0 .627.285.627.63 0 .349-.281.63-.63.63h-1.755v1.125h1.755zm-3.855 3.016a.63.63 0 0 1-.629.629.62.62 0 0 1-.51-.252l-2.443-3.317v2.94a.63.63 0 1 1-1.257 0V8.108c0-.27.174-.51.432-.596.064-.021.133-.031.199-.031.196 0 .378.103.49.256l2.456 3.331V8.108a.63.63 0 1 1 1.262 0v4.771zm-5.741 0a.63.63 0 1 1-1.257 0V8.108a.629.629 0 1 1 1.257 0v4.771zm-2.466.629H4.917a.628.628 0 0 1-.626-.629V8.108a.63.63 0 1 1 1.255 0v4.141h1.757c.349 0 .629.283.629.63 0 .346-.282.629-.629.629zM24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.121.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
          </a>
          <% } %>
        </div>
      </div>
      <div>
        <h5>ผลิตภัณฑ์</h5>
        <ul>
          <li><a href="/?cls=1">ประกันชั้น 1</a></li>
          <li><a href="/?cls=2plus">ประกันชั้น 2+</a></li>
          <li><a href="/?cls=3plus">ประกันชั้น 3+</a></li>
          <li><a href="/compare">เปรียบเทียบแผน</a></li>
        </ul>
      </div>
      <div>
        <h5>บริษัท</h5>
        <ul>
          <li><a href="/#how">วิธีการใช้งาน</a></li>
          <li><a href="/#insurers">บริษัทคู่ค้า</a></li>
          <li><a href="/#faq">คำถามที่พบบ่อย</a></li>
        </ul>
      </div>
      <div>
        <h5>ติดต่อ</h5>
        <div class="footer__contact">
          <% if (locals.sitePhone) { %>
          <div><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ico"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.13 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg> <%= locals.sitePhone %></div>
          <% } %>
          <% if (locals.lineOaUrl) { %>
          <div><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="ico"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63h-1.755v1.125h1.755c.349 0 .63.283.63.63s-.281.628-.63.628h-2.385a.631.631 0 0 1-.627-.629V8.108c0-.345.281-.63.63-.63h2.385c.346 0 .627.285.627.63 0 .349-.281.63-.63.63h-1.755v1.125h1.755zm-3.855 3.016a.63.63 0 0 1-.629.629.62.62 0 0 1-.51-.252l-2.443-3.317v2.94a.63.63 0 1 1-1.257 0V8.108c0-.27.174-.51.432-.596.064-.021.133-.031.199-.031.196 0 .378.103.49.256l2.456 3.331V8.108a.63.63 0 1 1 1.262 0v4.771zm-5.741 0a.63.63 0 1 1-1.257 0V8.108a.629.629 0 1 1 1.257 0v4.771zm-2.466.629H4.917a.628.628 0 0 1-.626-.629V8.108a.63.63 0 1 1 1.255 0v4.141h1.757c.349 0 .629.283.629.63 0 .346-.282.629-.629.629zM24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.121.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg> <a href="<%= locals.lineOaUrl %>" target="_blank" rel="noopener">LINE OA</a></div>
          <% } %>
          <div>ทุกวัน 08:00 – 18:00</div>
        </div>
      </div>
    </div>
    <div class="footer__bottom">
      <span>&copy; <%= year %> <%= siteName %>. สงวนลิขสิทธิ์.</span>
      <div class="footer__bottom-links">
        <a href="#">นโยบายความเป็นส่วนตัว</a>
        <a href="#">เงื่อนไขการใช้งาน</a>
      </div>
    </div>
  </div>
</footer>

<% if (locals.lineOaUrl) { %>
<a href="<%= locals.lineOaUrl %>" class="line-floating" target="_blank" rel="noopener">
  <span class="line-floating__ico">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63h-1.755v1.125h1.755c.349 0 .63.283.63.63s-.281.628-.63.628h-2.385a.631.631 0 0 1-.627-.629V8.108c0-.345.281-.63.63-.63h2.385c.346 0 .627.285.627.63 0 .349-.281.63-.63.63h-1.755v1.125h1.755zm-3.855 3.016a.63.63 0 0 1-.629.629.62.62 0 0 1-.51-.252l-2.443-3.317v2.94a.63.63 0 1 1-1.257 0V8.108c0-.27.174-.51.432-.596.064-.021.133-.031.199-.031.196 0 .378.103.49.256l2.456 3.331V8.108a.63.63 0 1 1 1.262 0v4.771zm-5.741 0a.63.63 0 1 1-1.257 0V8.108a.629.629 0 1 1 1.257 0v4.771zm-2.466.629H4.917a.628.628 0 0 1-.626-.629V8.108a.63.63 0 1 1 1.255 0v4.141h1.757c.349 0 .629.283.629.63 0 .346-.282.629-.629.629zM24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.121.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
  </span>
  ติดต่อทาง LINE
</a>
<% } %>

<script src="/public/js/main.js"></script>
</body>
</html>
