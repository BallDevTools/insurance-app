<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= siteName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Sarabun:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/style.css">
  <% if (locals.gtmHeadCode) { %><%- locals.gtmHeadCode %><% } %>
</head>
<body class="public-site">
<% if (locals.gtmBodyCode) { %><%- locals.gtmBodyCode %><% } %>
  <header class="public-nav-wrap">
    <div class="container">
      <nav class="public-nav">
        <a href="/" class="public-brand">
          <span class="public-brand-mark">🛡️</span>
          <strong class="pub-brand-name">ประกันรถดีดี</strong>
        </a>

        <div class="public-nav-links">
          <a href="/#about">เกี่ยวกับเรา</a>
          <a href="/#insurers">บริษัทชั้นนำ</a>
          <a href="/#faq">คำถามที่พบบ่อย</a>
        </div>

        <div class="public-nav-actions">
          <a href="#" class="public-nav-line">💬 ติดต่อทาง LINE</a>
        </div>
      </nav>
    </div>
  </header>

  <main class="public-main">
    <%- body %>
  </main>

  <footer class="public-footer">
    <div class="container">
      <div class="pub-footer-grid">
        <div>
          <div class="public-footer-brand">ประกันรถดีดี</div>
          <p>เปรียบเทียบและเลือกประกันรถยนต์จากบริษัทชั้นนำ ง่าย รวดเร็ว ใสสะอาด</p>
        </div>
        <div>
          <h4>ผลิตภัณฑ์</h4>
          <ul>
            <li><a href="/">ประกันชั้น 1</a></li>
            <li><a href="/">ประกันชั้น 2+</a></li>
            <li><a href="/">ประกันชั้น 3+</a></li>
            <li><a href="/compare">เปรียบเทียบแผน</a></li>
          </ul>
        </div>
        <div>
          <h4>บริษัท</h4>
          <ul>
            <li><a href="/#about">เกี่ยวกับเรา</a></li>
            <li><a href="/#insurers">บริษัทคู่ค้า</a></li>
            <li><a href="/#faq">คำถามที่พบบ่อย</a></li>
          </ul>
        </div>
        <div>
          <h4>ช่วยเหลือ</h4>
          <ul>
            <li><a href="tel:02-xxx-xxxx">โทร 02-xxx-xxxx</a></li>
            <li><a href="mailto:info@insurance.co.th">info@insurance.co.th</a></li>
            <li>ทุกวัน 08:00 – 18:00</li>
          </ul>
        </div>
      </div>
      <div class="pub-footer-bottom">
        <p>&copy; <%= year %> <%= siteName %>. สงวนลิขสิทธิ์.</p>
        <div class="pub-footer-links">
          <a href="#">นโยบายความเป็นส่วนตัว</a>
          <a href="#">เงื่อนไขการใช้งาน</a>
        </div>
      </div>
    </div>
  </footer>

  <script src="/public/js/main.js"></script>
</body>
</html>
