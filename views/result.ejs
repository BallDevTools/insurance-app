<!-- RESULT HEADER -->
<section class="front-page-head">
  <div class="container">
    <div class="front-page-head-row">
      <a href="/" class="front-back-link">← กลับไปเช็คราคาใหม่</a>
    </div>
    <h1>เรามีแผนประกันที่เหมาะกับคุณ</h1>

    <!-- Gradient Summary Card -->
    <div class="pub-result-summary">
      <div class="pub-result-summary-item">
        <div class="pub-result-summary-icon">🚗</div>
        <div>
          <div class="pub-result-summary-sub">รถของคุณ</div>
          <div class="pub-result-summary-val"><%= lead.brand %> <%= lead.model %></div>
        </div>
      </div>
      <div class="pub-result-summary-item">
        <div class="pub-result-summary-icon">📅</div>
        <div>
          <div class="pub-result-summary-sub">ปีรถ</div>
          <div class="pub-result-summary-val"><%= lead.year %></div>
        </div>
      </div>
      <div class="pub-result-summary-item">
        <div class="pub-result-summary-icon">🛡️</div>
        <div>
          <div class="pub-result-summary-sub">ประกันที่เลือก</div>
          <div class="pub-result-summary-val"><%= insuranceConfig.label %></div>
        </div>
      </div>
    </div>
    <% if (lead.model_id) { %>
    <div style="text-align:center;margin-top:1rem">
      <a href="/compare?model_id=<%= lead.model_id %>&year=<%= lead.year %>" class="front-back-link">⚖️ เปรียบเทียบราคาทุกชั้นประกัน</a>
    </div>
    <% } %>
  </div>
</section>

<!-- RESULT GRID -->
<section class="front-result-shell">
  <div class="container">
    <div class="front-result-grid-v2">

      <!-- Main: Package List -->
      <div class="front-result-main-v2">
        <div class="front-section-head front-section-head-left">
          <h2>แผนประกันที่น่าสนใจสำหรับรถของคุณ</h2>
        </div>

        <% if (packages.length > 0) { %>
          <div class="front-package-list-v2">
            <% packages.forEach(function(pkg, i) { %>
              <%
                var displayPrice = pkg.premium_discounted && parseFloat(pkg.premium_discounted) < parseFloat(pkg.premium_amount)
                  ? pkg.premium_discounted : pkg.premium_amount
                var hasCoverage = pkg.coverage && (pkg.coverage.own_vehicle || pkg.coverage.third_party || pkg.coverage.extra)
                var pkgId = 'pkg-' + i
              %>
              <article class="front-package-card-v2 <%= i === 0 ? 'featured' : '' %>">
                <div class="front-package-top-v2">
                  <div>
                    <span class="front-plan-badge"><%= i === 0 ? 'แนะนำ' : 'ตัวเลือกเพิ่มเติม' %></span>
                    <h3><%= pkg.company_name %></h3>
                    <p><%= insuranceConfig.label %></p>
                  </div>
                  <div class="front-package-price-v2">
                    <% if (pkg.premium_discounted && parseFloat(pkg.premium_discounted) < parseFloat(pkg.premium_amount)) { %>
                      <small><%= formatNumber(pkg.premium_amount) %> บาท</small>
                    <% } %>
                    <strong><%= formatNumber(displayPrice) %></strong>
                    <span>บาท/ปี</span>
                  </div>
                </div>

                <% if (hasCoverage) { %>
                  <button class="btn-expand" onclick="toggleCoverage('<%= pkgId %>', this)" type="button">ดูความคุ้มครอง</button>
                  <div id="<%= pkgId %>" class="pkg-coverage-detail" style="display:none">
                    <% var cov = pkg.coverage %>
                    <% if (cov.own_vehicle && Object.keys(cov.own_vehicle).length > 0) { %>
                      <div class="cov-section-title">ความรับผิดต่อรถของคุณ</div>
                      <table class="cov-table">
                        <% Object.entries(cov.own_vehicle).forEach(function([k,v]) { %>
                          <tr><td class="cov-key"><%= k %></td><td class="cov-val"><%= v %></td></tr>
                        <% }) %>
                      </table>
                    <% } %>
                    <% if (cov.third_party && Object.keys(cov.third_party).length > 0) { %>
                      <div class="cov-section-title">ความรับผิดต่อบุคคลภายนอก</div>
                      <table class="cov-table">
                        <% Object.entries(cov.third_party).forEach(function([k,v]) { %>
                          <tr><td class="cov-key"><%= k %></td><td class="cov-val"><%= v %></td></tr>
                        <% }) %>
                      </table>
                    <% } %>
                    <% if (cov.extra && Object.keys(cov.extra).length > 0) { %>
                      <div class="cov-section-title">ความคุ้มครองเพิ่มเติม</div>
                      <table class="cov-table">
                        <% Object.entries(cov.extra).forEach(function([k,v]) { %>
                          <tr><td class="cov-key"><%= k %></td><td class="cov-val"><%= v %></td></tr>
                        <% }) %>
                      </table>
                    <% } %>
                  </div>
                <% } %>

                <!-- CTA per package -->
                <div class="pub-pkg-cta-row">
                  <a href="/click/line?token=<%= lead.token %>" class="pub-pkg-cta-line" target="_blank" rel="noopener">
                    💬 รับรายละเอียดทาง LINE
                  </a>
                </div>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <div class="front-empty-card">
            <h2>ยังไม่พบราคาในระบบสำหรับข้อมูลชุดนี้</h2>
            <p>คุณยังสามารถติดต่อทีมงานได้ทันที เพื่อให้เราช่วยค้นหาแผนที่เหมาะสมให้</p>
            <div class="front-side-actions" style="margin-top:1rem">
              <a href="/click/line?token=<%= lead.token %>" class="front-line-btn" target="_blank" rel="noopener">💬 ติดต่อทาง LINE</a>
              <a href="/click/facebook?token=<%= lead.token %>" class="front-facebook-btn" target="_blank" rel="noopener">📘 คุยผ่าน Facebook</a>
            </div>
          </div>
        <% } %>

        <div class="front-note-card">
          <strong>ข้อมูลที่ใช้ในครั้งนี้</strong>
          <p><%= new Date(lead.created_at).toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
        </div>
      </div>

      <!-- Sidebar: Contact Panel -->
      <aside class="front-result-side-v2">
        <div class="front-contact-card-v2">
          <h2>ต้องการความช่วยเหลือ?</h2>
          <p>ทีมเราพร้อมให้คำปรึกษาและช่วยเลือกแผนที่เหมาะกับคุณ</p>

          <% if (lead.best_price) { %>
            <div class="front-price-highlight">
              <small>ราคาเริ่มต้นจากข้อมูลนี้</small>
              <strong><%= formatNumber(lead.best_price) %></strong>
              <span>บาท/ปี</span>
            </div>
          <% } %>

          <div class="front-side-actions">
            <a href="/click/line?token=<%= lead.token %>" class="front-line-btn" target="_blank" rel="noopener">
              💬 ติดต่อทาง LINE
            </a>
            <a href="/click/facebook?token=<%= lead.token %>" class="front-facebook-btn" target="_blank" rel="noopener">
              📘 คุยผ่าน Facebook
            </a>
          </div>

          <ul class="front-check-list">
            <li>ทีมเราจะติดต่อกลับภายใน 5 นาที</li>
            <li>ช่วยเลือกแผนให้เหมาะกับรถ</li>
            <li>อธิบายรายละเอียดแบบเข้าใจง่าย</li>
          </ul>
        </div>
      </aside>

    </div>
  </div>
</section>

<!-- Mobile Bottom CTA Bar -->
<div class="pub-mobile-cta-bar">
  <a href="/click/facebook?token=<%= lead.token %>" class="pub-mobile-cta-fb" target="_blank" rel="noopener">
    📘 Facebook
  </a>
  <a href="/click/line?token=<%= lead.token %>" class="pub-mobile-cta-line" target="_blank" rel="noopener">
    💬 LINE
  </a>
</div>

<script>
function toggleCoverage(id, btn) {
  var el = document.getElementById(id)
  if (!el) return
  var open = el.style.display !== 'none'
  el.style.display = open ? 'none' : 'block'
  btn.textContent = open ? 'ดูความคุ้มครอง' : 'ซ่อนความคุ้มครอง'
  btn.classList.toggle('open', !open)
}
</script>
