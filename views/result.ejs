<!-- Quote PDF Modal -->
<div class="quote-modal" id="quoteModal" onclick="if(event.target===this)closeQuoteModal()">
  <div class="quote-modal__card">
    <div class="quote-modal__header">
      <h2>ใบเสนอราคา</h2>
      <button class="quote-modal__close" onclick="closeQuoteModal()" type="button" aria-label="ปิด">✕</button>
    </div>
    <div class="quote-modal__doc" id="quoteModalDoc"></div>
    <div class="quote-modal__foot">
      <button class="quote-modal__dl-btn" id="quoteModalDlBtn" type="button">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7,10 12,15 17,10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        ดาวน์โหลด PDF
      </button>
      <button class="quote-modal__cancel-btn" onclick="closeQuoteModal()" type="button">ปิด</button>
    </div>
  </div>
</div>

<script>
// pkg coverage toggle
function togglePkgCov(id, btn) {
  var el = document.getElementById(id)
  if (!el) return
  var opening = !el.classList.contains('is-open')
  if (opening) {
    el.style.display = 'block'
    el.style.overflow = 'hidden'
    el.style.height = '0'
    var h = el.scrollHeight
    el.style.transition = 'height 0.3s ease'
    requestAnimationFrame(function() { el.style.height = h + 'px' })
    el.addEventListener('transitionend', function done() {
      el.style.height = el.style.overflow = el.style.transition = ''
      el.classList.add('is-open')
      el.removeEventListener('transitionend', done)
    })
  } else {
    el.style.overflow = 'hidden'
    el.style.height = el.scrollHeight + 'px'
    el.style.transition = 'height 0.3s ease'
    requestAnimationFrame(function() { el.style.height = '0' })
    el.addEventListener('transitionend', function done() {
      el.style.display = 'none'
      el.style.height = el.style.overflow = el.style.transition = ''
      el.classList.remove('is-open')
      el.removeEventListener('transitionend', done)
    })
  }
  btn.textContent = opening ? '▲ ซ่อนรายละเอียด' : '▼ คลิกดูรายละเอียด'
}

// filter chips
;(function() {
  var activeFilter = 'all'
  document.querySelectorAll('.filter-chip[data-filter]').forEach(function(chip) {
    chip.addEventListener('click', function() {
      document.querySelectorAll('.filter-chip[data-filter]').forEach(function(c) { c.classList.remove('is-active') })
      this.classList.add('is-active')
      activeFilter = this.dataset.filter
      applyFilter()
    })
  })
  function applyFilter() {
    document.querySelectorAll('#pkgList .pkg').forEach(function(card) {
      var show = activeFilter === 'all' ||
        (activeFilter === 'authorized' && card.dataset.repair === 'authorized') ||
        (activeFilter === 'flood' && card.dataset.flood === '1')
      card.style.display = show ? '' : 'none'
    })
  }
})()

// sort
document.getElementById('sortSelect')?.addEventListener('change', function() {
  var list = document.getElementById('pkgList')
  if (!list) return
  var cards = Array.from(list.querySelectorAll('.pkg'))
  cards.sort(function(a, b) {
    var pa = parseFloat(a.dataset.price) || 0
    var pb = parseFloat(b.dataset.price) || 0
    return this.value === 'asc' ? pa - pb : pb - pa
  }.bind(this))
  cards.forEach(function(c) { list.appendChild(c) })
})

// compare
var PKG_DATA = <%- JSON.stringify(packages.map(function(p) {
  return {
    id: p.id,
    company: p.company_name,
    insurance_class: p.insurance_class,
    price: parseFloat(p.premium_discounted && parseFloat(p.premium_discounted) < parseFloat(p.premium_amount) ? p.premium_discounted : p.premium_amount) || 0,
    repair_type: p.repair_type || null,
    has_flood: p.has_flood ? 1 : 0,
    coverage: p.coverage || {}
  }
})).replace(/<\//g, '<\\/') %>;
var LEAD_TOKEN = '<%= lead.token %>';
var LEAD_DATA = <%- JSON.stringify({ name: lead.name || '', phone: lead.phone || '', brand: lead.brand || '', model: lead.model || '', year: lead.year || '' }).replace(/<\//g, '<\\/') %>;

;(function() {
  var selected = []
  var MAX = 3

  function numFmt(n) { return Number(n).toLocaleString('th-TH') }

  function updateBar() {
    var bar  = document.getElementById('compareBar')
    var badge = document.getElementById('compareBarBadge')
    var text  = document.getElementById('compareBarText')
    var go    = document.getElementById('compareBarGo')
    if (!bar) return
    bar.classList.toggle('is-visible', selected.length > 0)
    badge.textContent = selected.length
    var remaining = MAX - selected.length
    text.textContent = selected.length >= MAX
      ? 'แผน · เต็มแล้ว! (สูงสุด ' + MAX + ' แผน)'
      : 'แผน · เพิ่มอีก ' + remaining + (remaining === 1 ? ' แผน' : ' แผน') + ' เพื่อเปรียบเทียบ'
    go.disabled = selected.length < 2
  }

  function setBtn(idx, active) {
    var btn = document.querySelector('.btn-compare[data-idx="' + idx + '"]')
    if (!btn) return
    btn.classList.toggle('is-selected', active)
    btn.textContent = active ? '✓ เพิ่มแล้ว' : '+ เปรียบเทียบ'
  }

  function addPkg(idx) {
    if (selected.indexOf(idx) !== -1 || selected.length >= MAX) return
    selected.push(idx)
    setBtn(idx, true)
    updateBar()
  }

  function removePkg(idx) {
    var i = selected.indexOf(idx)
    if (i === -1) return
    selected.splice(i, 1)
    setBtn(idx, false)
    updateBar()
  }

  document.querySelectorAll('.btn-compare').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var idx = parseInt(this.dataset.idx)
      selected.indexOf(idx) !== -1 ? removePkg(idx) : addPkg(idx)
    })
  })

  document.getElementById('compareBarClear')?.addEventListener('click', function() {
    selected.slice().forEach(removePkg)
  })

  document.getElementById('compareBarGo')?.addEventListener('click', goCompare)

  function goCompare() {
    var ids = selected.map(function(idx) { return PKG_DATA[idx] && PKG_DATA[idx].id }).filter(Boolean).join(',')
    if (!ids) return
    window.location.href = '/compare-view?pkg_ids=' + ids + '&token=' + LEAD_TOKEN
  }

})()

// Quote modal
function openQuoteModal(idx) {
  var pkg = PKG_DATA[idx]
  if (!pkg) return
  var price = pkg.price
  var net   = Math.round(price / 1.07428)
  var tax   = Math.round(price - net)
  var qNo   = 'QT-' + String(pkg.id).padStart(6, '0')
  var today = new Date().toLocaleDateString('th-TH', { day: '2-digit', month: 'long', year: 'numeric' })
  var expiry = new Date(Date.now() + 30*24*60*60*1000).toLocaleDateString('th-TH', { day: '2-digit', month: 'long', year: 'numeric' })
  var repairLabel = pkg.repair_type === 'authorized' ? 'ซ่อมศูนย์' : 'ซ่อมอู่'
  function fmt(n) { return Number(n).toLocaleString('th-TH') }

  var covItems = ['<span class="qdoc__cov-ic">✓</span> ประกันชั้น ' + pkg.insurance_class + ' · ' + repairLabel]
  if (pkg.has_flood) covItems.push('<span class="qdoc__cov-ic">✓</span> คุ้มครองภัยน้ำท่วม')
  if (pkg.coverage && pkg.coverage.own_vehicle) {
    Object.entries(pkg.coverage.own_vehicle).slice(0, 3).forEach(function(e) {
      covItems.push('<span class="qdoc__cov-ic">✓</span> ' + e[0] + ': ' + e[1])
    })
  }

  document.getElementById('quoteModalDoc').innerHTML =
    '<div class="qdoc">'
    + '<div class="qdoc__hdr"><div class="qdoc__hdr-title">ใบเสนอราคาประกันภัยรถยนต์</div><div class="qdoc__hdr-sub">' + (pkg.company || '') + '</div></div>'
    + '<div class="qdoc__meta"><span>เลขที่: ' + qNo + '</span><span>วันที่: ' + today + '</span></div>'
    + '<div class="qdoc__grid">'
      + '<div><div class="qdoc__block-label">ผู้เอาประกัน</div><div class="qdoc__block-val">' + (LEAD_DATA.name || '-') + '</div><div class="qdoc__block-val2">' + (LEAD_DATA.phone || '') + '</div></div>'
      + '<div><div class="qdoc__block-label">รถยนต์</div><div class="qdoc__block-val">' + LEAD_DATA.brand + ' ' + LEAD_DATA.model + '</div><div class="qdoc__block-val2">ปี ' + LEAD_DATA.year + '</div></div>'
    + '</div>'
    + '<div class="qdoc__cov">' + covItems.map(function(i){ return '<div class="qdoc__cov-item">' + i + '</div>' }).join('') + '</div>'
    + '<div class="qdoc__price">'
      + '<div class="qdoc__price-row"><span>เบี้ยประกันสุทธิ</span><span>' + fmt(net) + ' บาท</span></div>'
      + '<div class="qdoc__price-row"><span>อากรแสตมป์ + ภาษีมูลค่าเพิ่ม</span><span>' + fmt(tax) + ' บาท</span></div>'
      + '<div class="qdoc__price-row qdoc__price-row--total"><span>รวมทั้งสิ้น</span><span>฿' + fmt(price) + '</span></div>'
    + '</div>'
    + '<div class="qdoc__footer">ใบเสนอราคามีผลถึง ' + expiry + '</div>'
    + '</div>'

  document.getElementById('quoteModalDlBtn').onclick = function() {
    window.open('/api/quote-pdf?token=' + LEAD_TOKEN + '&pkg_id=' + pkg.id, '_blank')
  }
  document.getElementById('quoteModal').classList.add('is-open')
  document.body.style.overflow = 'hidden'
}

function closeQuoteModal() {
  document.getElementById('quoteModal').classList.remove('is-open')
  document.body.style.overflow = ''
}
</script>
